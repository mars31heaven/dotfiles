#!/bin/sh

FILE="$1"
WIDTH="$2"

handle() {
    if [ -d "$FILE" ]; then
        tree -C -L 1 -F "$FILE"
    elif [ -f "$FILE" ]; then
        if command -v highlight >/dev/null 2>&1; then
            highlight "$FILE" -O ansi --force
        else
            cat "$FILE"
        fi
    fi
}

case "$FILE" in
    *.mp3|*.flac|*.wav|*.ogg|*.opus|*.m4a|*.mp4|*.mkv|*.webm|*.avi|*.mpg|*.mov)
        mediainfo "$FILE"
        ;;
    *.png|*.gif|*.jpg|*.jpe|*.jpeg|*.tiff|*.webp)
        exiv2 "$FILE"
        ;;
    *.epub)
        if command -v epub-info >/dev/null 2>&1; then
            epub-info "$FILE"
        elif command -v unzip >/dev/null 2>&1; then
            echo "--- EPUB METADATA ---"
            unzip -p "$FILE" "*content.opf" 2>/dev/null | grep -E '<dc:|title|creator|date' | sed -e 's/<[^>]*>//g' -e 's/^[ \t]*//'
        else
            echo "Install 'unzip' or 'epub-info' to preview epub metadata."
        fi
        ;;
    *.md)
        if command -v mdcat >/dev/null 2>&1; then
            mdcat --columns "$WIDTH" "$FILE"
        elif command -v glow >/dev/null 2>&1; then
            glow -s dark "$FILE"
        else
            cat "$FILE"
        fi
        ;;
    *.docx|*.xlsx|*.pptx|*.pdf|*.doc|*.xls)
        if command -v batdoc >/dev/null 2>&1; then
            batdoc --plain "$FILE" | head -n 100
        else
            echo "Install 'batdoc' to preview office documents and PDFs."
        fi
        ;;
    *.html|*.htm)
        w3m -dump "$FILE"
        ;;
    *.zip)
        zipinfo "$FILE"
        ;;
    *.tar|*.tar.*|*.tgz|*.txz|*.tbz2)
        tar -tf "$FILE"
        ;;
    *.rar)
        unrar l "$FILE"
        ;;
    *.7z)
        7z l "$FILE"
        ;;
    *)
        handle "$FILE"
        ;;
esac
