#!/bin/sh
#
# preview
#
# File preview script for lf and fzf.
#
# Usage:
#   preview FILE [WIDTH]
#
# Supports:
#   - directories
#   - text and source files
#   - Markdown
#   - audio/video metadata
#   - image metadata
#   - EPUB metadata
#   - office documents and PDFs
#   - HTML
#   - archives
#
# Recommended packages:
#   bat
#   highlight
#   mediainfo
#   exiv2
#   mdcat or glow
#   batdoc
#   w3m
#   unzip
#   zip
#   unrar
#   p7zip

FILE=$1
WIDTH=${2:-80}

[ -n "$FILE" ] || exit 1

if [ ! -e "$FILE" ]; then
    printf 'File not found:\n%s\n' "$FILE"
    exit 0
fi

lowercase_extension() {
    printf '%s' "${FILE##*.}" | tr '[:upper:]' '[:lower:]'
}

EXTENSION=$(lowercase_extension)

show_text() {
    if command -v bat >/dev/null 2>&1; then
        bat \
            --color=always \
            --style=numbers \
            --paging=never \
            --wrap=never \
            --terminal-width="$WIDTH" \
            -- "$FILE" 2>/dev/null
    elif command -v highlight >/dev/null 2>&1; then
        highlight \
            -O ansi \
            --force \
            -- "$FILE" 2>/dev/null
    else
        sed -n '1,500p' -- "$FILE"
    fi
}

show_media_metadata() {
    if command -v mediainfo >/dev/null 2>&1; then
        mediainfo -- "$FILE" 2>/dev/null
    elif command -v ffprobe >/dev/null 2>&1; then
        ffprobe \
            -v error \
            -show_format \
            -show_streams \
            -of default=noprint_wrappers=1 \
            -- "$FILE" 2>/dev/null
    elif command -v exiftool >/dev/null 2>&1; then
        exiftool -- "$FILE" 2>/dev/null
    else
        file --brief -- "$FILE"
    fi
}

show_image_metadata() {
    if command -v exiv2 >/dev/null 2>&1; then
        exiv2 -- "$FILE" 2>/dev/null
    elif command -v exiftool >/dev/null 2>&1; then
        exiftool -- "$FILE" 2>/dev/null
    else
        file --brief -- "$FILE"
    fi
}

show_epub_metadata() {
    if command -v epub-info >/dev/null 2>&1; then
        epub-info "$FILE" 2>/dev/null
    elif command -v unzip >/dev/null 2>&1; then
        printf '%s\n' '--- EPUB METADATA ---'

        unzip -p "$FILE" '*content.opf' 2>/dev/null |
            grep -E '<dc:|title|creator|date|language|publisher' |
            sed \
                -e 's/<[^>]*>//g' \
                -e 's/^[[:space:]]*//' |
            head -n 80
    else
        printf '%s\n' "Install 'unzip' or 'epub-info' for EPUB metadata."
    fi
}

show_office_document() {
    if command -v batdoc >/dev/null 2>&1; then
        batdoc --plain "$FILE" 2>/dev/null | head -n 120

    elif [ "$EXTENSION" = "pdf" ] && command -v pdftotext >/dev/null 2>&1; then
        pdftotext "$FILE" - 2>/dev/null | head -n 120

    else
        printf '%s\n' \
            "Install 'batdoc' to preview office documents and PDFs."
    fi
}

show_directory() {
    if command -v eza >/dev/null 2>&1; then
        eza \
            --all \
            --group-directories-first \
            --color=always \
            --icons=auto \
            -- "$FILE"
    elif command -v tree >/dev/null 2>&1; then
        tree -C -L 1 -F -- "$FILE"
    else
        ls -la -- "$FILE"
    fi
}

show_archive() {
    case "$EXTENSION" in
        zip)
            if command -v zipinfo >/dev/null 2>&1; then
                zipinfo -- "$FILE"
            else
                unzip -l "$FILE" 2>/dev/null
            fi
            ;;
        tar)
            tar -tf "$FILE" 2>/dev/null
            ;;
        tgz|gz)
            tar -tzf "$FILE" 2>/dev/null
            ;;
        txz|xz)
            tar -tJf "$FILE" 2>/dev/null
            ;;
        tbz|tbz2|bz2)
            tar -tjf "$FILE" 2>/dev/null
            ;;
        rar)
            if command -v unrar >/dev/null 2>&1; then
                unrar l "$FILE" 2>/dev/null
            else
                printf '%s\n' "Install 'unrar' to list RAR archive contents."
            fi
            ;;
        7z)
            if command -v 7z >/dev/null 2>&1; then
                7z l -- "$FILE"
            else
                printf '%s\n' "Install '7zip' to list 7z archive contents."
            fi
            ;;
    esac
}

if [ -d "$FILE" ]; then
    show_directory
    exit 0
fi

case "$EXTENSION" in
    mp3|flac|wav|ogg|opus|m4a|aac|wma|aiff|aif|\
    mp4|mkv|webm|avi|mpg|mpeg|mov|m4v)
        show_media_metadata
        ;;

    png|gif|jpg|jpeg|jpe|tiff|tif|webp|bmp|avif)
        show_image_metadata
        ;;

    epub)
        show_epub_metadata
        ;;

    md|markdown|mdown|mkdn)
        if command -v mdcat >/dev/null 2>&1; then
            mdcat --columns="$WIDTH" -- "$FILE" 2>/dev/null
        elif command -v glow >/dev/null 2>&1; then
            glow -s dark -- "$FILE" 2>/dev/null
        else
            show_text
        fi
        ;;

    pdf|doc|docx|odt|xls|xlsx|ods|ppt|pptx)
        show_office_document
        ;;

    html|htm)
        if command -v w3m >/dev/null 2>&1; then
            w3m -dump -- "$FILE" 2>/dev/null
        else
            show_text
        fi
        ;;

    zip|tar|tgz|gz|txz|xz|tbz|tbz2|bz2|rar|7z)
        show_archive
        ;;

    *)
        MIME_TYPE=$(file --brief --mime-type -- "$FILE" 2>/dev/null)

        case "$MIME_TYPE" in
            text/*|\
            application/json|\
            application/javascript|\
            application/xml|\
            application/x-shellscript|\
            application/x-yaml|\
            application/toml)
                show_text
                ;;
            *)
                printf 'File: %s\n\n' "$FILE"
                file --brief -- "$FILE"

                if command -v exiftool >/dev/null 2>&1; then
                    printf '\n--- Metadata ---\n\n'
                    exiftool -- "$FILE" 2>/dev/null | head -n 100
                fi
                ;;
        esac
        ;;
esac
