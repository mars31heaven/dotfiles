# ── Appearance ───────────────────────────────────────────────

set previewer "~/.config/lf/preview"
set preview
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"
set scrolloff 10
set relativenumber
set incsearch


# ── Basic operations ─────────────────────────────────────────

map . set hidden!
map x cut
map y copy
map p paste
map D delete
map R reload
map U unselect
map v toggle
map V invert
map u half-up
map d half-down

map X extract
map A rename
map B bulkrename

map m push :mkdir<space>
map E push :!nvim<space>
map W $setsid -f "$TERMINAL" >/dev/null 2>&1

map o open
map <enter> shell


# ── Clipboard ────────────────────────────────────────────────

map <c-y> path_yank


# ── Commands ─────────────────────────────────────────────────

cmd bulkrename $vidir

cmd mkdir $mkdir -p "$(echo $* | tr ' ' '\ ')"

cmd extract ${{
    case "$f" in
        *.zip)
            for f in *.zip; do
                unzip "$f" -d "${f%.zip}"
            done
            ;;
        *.7z)
            7z x "$f"
            ;;
        *.tar.gz)
            tar -xzvf "$f"
            ;;
        *.tar.xz)
            tar -xvf "$f"
            ;;
        *.tar.bz2)
            tar -xjvf "$f"
            ;;
        *.tar)
            tar -xvf "$f"
            ;;
        *.tgz)
            tar zxvf "$f"
            ;;
        *.rar)
            for f in *.rar; do
                unrar x "$f"
            done
            ;;
        *)
            echo "Unsupported format"
            ;;
    esac
}}

cmd path_yank ${{
    printf '%s\n' "$fx" | wl-copy
}}


# ── Bookmarks ────────────────────────────────────────────────

source "~/.config/lf/shortcutrc"
