# ── Appearance ───────────────────────────────────────────────

set shell bash

set previewer "~/.config/lf/preview"
set preview
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"

set scrolloff 10
set relativenumber
set incsearch

set selectfmt "\033[7;38;2;255;255;255m"
set cutfmt "\033[7;31m"


# ── Basic operations ─────────────────────────────────────────

map . set hidden!

map x cut
map y copy
map p paste
map D delete

map R reload
map U unselect
map v toggle
map V invert

map u half-up
map d half-down

map X extract
map A rename
map B bulkrename

map m push :mkdir<space>

map N push :touch<space>

map E push :!nvim<space>

# Open selected file in Neovim. lf returns when Neovim closes.
map e edit

# Open using lf's configured opener.
map o open

# Open a shell in lf's current directory.
map <enter> shell

# New terminal window.
map W $setsid -f "$TERMINAL" >/dev/null 2>&1


# ── Fuzzy navigation ─────────────────────────────────────────

# Find files from the current directory. The selected file opens in lf.
#
# Hidden and ignored files are included; .git is excluded.
cmd fzf_file ${{
    file=$(fd \
        --type f \
        --hidden \
        --no-ignore \
        --exclude .git \
        . "$PWD" |
        fzf \
            --prompt="Files> " \
            --preview='~/.config/lf/preview {} 100' \
            --preview-window='right:55%:wrap')

    [ -n "$file" ] || exit 0

    dir=$(dirname "$file")
    base=$(basename "$file")

    # Bash-style quoting keeps paths with spaces safe.
    printf -v quoted_dir '%q' "$dir"
    printf -v quoted_base '%q' "$base"

    lf -remote "send $id cd $quoted_dir"
    lf -remote "send $id select $quoted_base"
}}

map f fzf_file


# Fuzzy choose a directory below the current directory.
cmd fzf_cd ${{
    dir=$(fd \
        --type d \
        --hidden \
        --no-ignore \
        --exclude .git \
        . "$PWD" |
        fzf \
            --prompt="Directories> " \
            --preview='~/.config/lf/preview {} 100' \
            --preview-window='right:55%:wrap')

    [ -n "$dir" ] || exit 0

    printf -v quoted_dir '%q' "$dir"
    lf -remote "send $id cd $quoted_dir"
}}

map z fzf_cd


# Fuzzy jump using zoxide's directory history.
cmd zoxide_cd ${{
    dir=$(zoxide query --interactive)

    [ -n "$dir" ] || exit 0

    printf -v quoted_dir '%q' "$dir"
    lf -remote "send $id cd $quoted_dir"
}}

map Z zoxide_cd


# ── Clipboard ────────────────────────────────────────────────

map <c-y> path_yank


# ── Commands ─────────────────────────────────────────────────

cmd edit $nvim "$f"

cmd bulkrename $vidir

cmd mkdir $mkdir -p "$(echo $* | tr ' ' '\ ')"

cmd touch $touch "$@"

cmd extract ${{
    case "$f" in
        *.zip)
            for archive in *.zip; do
                unzip "$archive" -d "${archive%.zip}"
            done
            ;;
        *.7z)
            7z x "$f"
            ;;
        *.tar.gz)
            tar -xzvf "$f"
            ;;
        *.tar.xz)
            tar -xvf "$f"
            ;;
        *.tar.bz2)
            tar -xjvf "$f"
            ;;
        *.tar)
            tar -xvf "$f"
            ;;
        *.tgz)
            tar -xzvf "$f"
            ;;
        *.rar)
            for archive in *.rar; do
                unrar x "$archive"
            done
            ;;
        *)
            echo "Unsupported archive format"
            ;;
    esac
}}

cmd path_yank ${{
    printf '%s\n' "$fx" | wl-copy
}}


# ── Bookmarks ────────────────────────────────────────────────

source "~/.config/lf/shortcutrc"
