# ── External configuration ───────────────────────────────────

for file in \
    "$HOME/.config/shell/aliasrc" \
    "$HOME/.config/shell/shortcutrc" \
    "$HOME/.config/shell/functionrc" \
    "$HOME/.config/shell/private"
do
    [ -f "$file" ] && source "$file"
done


# ── Prompt ────────────────────────────────────────────────────

autoload -U colors && colors
PS1=' [%F{yellow}%m%f] %F{red}%~%f $ '


# ── History ───────────────────────────────────────────────────

HISTSIZE=100000
SAVEHIST=100000

setopt append_history
setopt share_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_expire_dups_first

# Don't pollute history with routine navigation/helpers.
zshaddhistory() {
    local command=${1%%$'\n'*}
    local first_word=${command%%[[:space:]]*}

    case "$first_word" in
        ls|l|ll|lll|lr|lt|l.|lh|lhr|t|o|fcd|lfcd|ipa)
            return 1
            ;;
    esac

    return 0
}


# ── Shell behavior ────────────────────────────────────────────

setopt autocd
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushdminus
setopt globdots
setopt extendedglob
setopt nocaseglob
setopt interactive_comments
setopt nocheckjobs
setopt numericglobsort
setopt nobeep
setopt correct


# ── Completion ────────────────────────────────────────────────

autoload -Uz compinit
compinit

# Enable the completion menu and its interactive selection keymap.
zmodload -i zsh/complist

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' rehash true


# ── Vi mode ───────────────────────────────────────────────────

bindkey -v
KEYTIMEOUT=1

bindkey '^?' backward-delete-char
bindkey '^[[3~' delete-char


# ── Plugins ───────────────────────────────────────────────────

source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=default,fg=magenta,underline'
typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=default,fg=yellow,underline'


# ── Completion menu navigation ────────────────────────────────

# Use Vim keys while navigating the completion menu.
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char


# ── History search ────────────────────────────────────────────

# Search through history for commands containing the text
# currently typed on the command line.
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Search history with Vim's j/k keys in command mode.
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down


# ── FZF ───────────────────────────────────────────────────────

source /usr/share/fzf/key-bindings.zsh
source /usr/share/fzf/completion.zsh
