#![enable(implicit_some)]
(
    text_color: "#e1e1db",
    background_color: "#313131",

    // Raised dark surfaces: headers, modals and inactive UI framing.
    header_background_color: "#383838",
    modal_background_color: "#101010",

    // Quiet structure. Borders should not compete with content.
    borders_style: (fg: "#555555"),

    // Secondary emphasis: search matches, labels and non-current highlights.
    highlight_style: (fg: "#d8cfd8"),

    // The current row is visible without becoming a large bright block.
    current_item_style: (fg: "#de7484", bg: "#383838"),

    // Pink remains the single strong interaction accent.
    active_pane_border_style: (fg: "#de7484"),

    tab_bar: (
    enabled: true,
    active_style: (fg: "#de7484", bg: "#383838"),
    inactive_style: (fg: "#d8cfd8", bg: "#313131"),
    ),

    progress_bar: (
        symbols: ["~", "~", "─"],

        // Dark neutral track, pale elapsed section, pink playhead.
        track_style: (fg: "#555555"),
        elapsed_style: (fg: "#d8cfd8"),
        thumb_style: (fg: "#de7484"),
    ),

    scrollbar: (
        symbols: ["|", "█", "|", "█"],
        track_style: (fg: "#313131"),
        ends_style: (fg: "#555555"),
        thumb_style: (fg: "#555555"),
    ),
)
