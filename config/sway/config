    # Workspace cycling
    bindsym $mod+i workspace prev
    bindsym $mod+o workspace next
    bindsym $mod+Tab workspace back_and_forth

    bindsym $mod+Shift+i move container to workspace prev
    bindsym $mod+Shift+o move container to workspace next

    # Multi monitor settings
    bindsym $mod+F1 exec swaymsg 'output eDP-1 enable; output HDMI-A-2 disable' && wlsunset -t 4000 -T 4200
    bindsym $mod+F2 exec swaymsg 'output eDP-1 disable; output HDMI-A-2 enable' && pkill wlsunset
    bindsym $mod+F3 exec swaymsg 'output eDP-1 enable; output HDMI-A-2 enable' && pkill wlsunset

    # Other shorcuts
    bindsym $mod+F12 exec itoggle

    bindsym $mod+Shift+Backspace exec fuzzpower
    bindsym $mod+p exec fuzzpass

    bindsym $mod+Shift+e exec foot nvim

    bindsym $mod+Home exec foot htop

    bindsym $mod+Shift+m exec foot lf

    bindsym $mod+Shift+v exec foot pulsemixer

    bindsym Ctrl+Space exec makoctl dismiss --all

    # Windows borders
    default_border pixel 1
    default_floating_border pixel 1

    client.focused          #e1e1db #e1e1db #313131 #e1e1db #e1e1db
    client.focused_inactive #d8cfd8 #d8cfd8 #313131 #d8cfd8 #d8cfd8
    client.unfocused        #555555 #555555 #313131 #555555 #555555
    client.urgent           #db3d2f #db3d3f #313131 #db3d3f #db3d3f

    # Hide cursor on inactivity
    seat * hide_cursor 5000
    seat * hide_cursor when-typing enable

    include /etc/sway/config.d/*

    # Swayidle
    exec swayidle -w \
    timeout 300 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    timeout 600 'systemctl suspend'

    for_window [app_id="reaper"] inhibit_idle open
    for_window [app_id="duckstation-qt"] inhibit_idle open

    # Autostart
    exec batsignal -b -w 20 -c 15 -d 12 -D "notify-send -u critical 'Battery critically low' 'Suspending now'; systemctl suspend" -f 90 -p

    exec sway-audio-idle-inhibit

    exec wl-paste --type text --watch cliphist store
    exec wl-paste --type image --watch cliphist store

    exec_always swaybg -i /home/mrcl/Pictures/mar.jpg -m fill

    exec mako
    exec waybar

    exec wlsunset -t 4000 -T 4200
