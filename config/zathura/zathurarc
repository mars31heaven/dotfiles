map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print
map t toggle_statusbar

set selection-clipboard "clipboard"
set database "sqlite"
set adjust-open "width"
set scroll-step 50

set recolor true
set recolor-lightcolor "#1e1e1e"
set recolor-darkcolor "#e1e1db"
set recolor-reverse-video true
set highlight-color "#de7484"
set highlight-active-color "#db3d3f"

set statusbar-h-padding 0
set statusbar-v-padding 0
set statusbar-home-tilde

set statusbar-bg "#313131"
set statusbar-fg "#e1e1db"

set inputbar-bg  "#313131"
set inputbar-fg  "#e1e1db"

set notification-bg "#313131"
set notification-fg "#e1e1db"
set notification-error-bg "#313131"
set notification-error-fg "#db3d3f"
set notification-warning-bg "#313131"
set notification-warning-fg "#d8cfd8"

set completion-bg "#555555"
set completion-fg "#e1e1db"
set completion-highlight-bg "#e1e1db"
set completion-highlight-fg "#313131"

set search-highlight "#db3d3f"
