# vim: filetype=sh

# Directories shortcuts
alias \
	h="cd ~ && ls" \
	d="cd ~/Documents && ls" \
	D="cd ~/Downloads && ls" \
	m="cd ~/Music && ls" \
	P="cd ~/Pictures && ls" \
	V="cd ~/Videos && ls" \
	dfs="cd ~/.dotfiles && ls && git status" \
	dx="cd ~/.dotfiles/bin && ls" \
	dcf="cd ~/.dotfiles/config && ls" \
	x="cd ~/.local/bin && ls" \
	shr="cd ~/.local/share && ls" \
	src="cd ~/.local/src && ls" \
	cf="cd ~/.config && ls" \
	ca="cd ~/.cache && ls" \
	M="cd /mnt && ls" \
	T="cd /tmp"
