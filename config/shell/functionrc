# ── Personal functions ────────────────────────────────────────

o() {
    local file
    file=$(find . -type f -not -path '*/.git/*' | fzf --layout=reverse) || return
    open "$file"
}

ipa() {
    ip addr | grep 192 | awk '{print $2}' | sed 's/\/24//'
}

lfcd() {
    local tmp dir

    tmp=$(mktemp)
    lf -last-dir-path="$tmp" "$@"

    if [[ -f "$tmp" ]]; then
        dir=$(<"$tmp")
        rm -f "$tmp" >/dev/null
        [[ -d "$dir" && "$dir" != "$PWD" ]] && cd -- "$dir"
    fi
}

fcd() {
    local dir
    dir=$(find . -type d | fzf --layout=reverse) || return
    cd -- "$dir"
}

album1() {
    local dir
    dir=$(find . -mindepth 1 -maxdepth 1 -type d | shuf -n 1) || return

    printf '▶ %s\n' "$dir"

    find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.m4a' \) \
        -print0 |
        sort -z |
        xargs -0 mpv --profile=music --input-ipc-server="${XDG_RUNTIME_DIR:-/tmp}/mpv-music.sock"
}

album2() {
    local dir
    dir=$(find . -mindepth 2 -maxdepth 2 -type d | shuf -n 1) || return

    printf '▶ %s\n' "$dir"

    find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.m4a' \) \
        -print0 |
        sort -z |
        xargs -0 mpv --profile=music --input-ipc-server="${XDG_RUNTIME_DIR:-/tmp}/mpv-music.sock"
}

rotate() {
    local deg="$1"
    local file="$2"

    [[ -f "$file" ]] || return 1

    jpegtran -rotate "$deg" -copy all "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

if [ -n "$BASH_VERSION" ]; then
    export -f rotate
fi

# ── Personal shortcuts ───────────────────────────────────────

bindkey -s '^p' 'pulsemixer\n'
bindkey -s '^o' 'lfcd\n'
bindkey -s '^a' 'bc -lq\n'
bindkey -s '^f' 'fcd\n'

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^v' edit-command-line

bindkey -s '^e' '$EDITOR\n'
