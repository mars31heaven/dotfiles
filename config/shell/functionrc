# ── Personal functions ────────────────────────────────────────

o() {
    local file
    file=$(find . -type f -not -path '*/.git/*' | fzf --layout=reverse) || return
    open "$file"
}

ipa() {
    ip addr | grep 192 | awk '{print $2}' | sed 's/\/24//'
}

lfcd() {
    local tmp dir

    tmp=$(mktemp)
    lf -last-dir-path="$tmp" "$@"

    if [[ -f "$tmp" ]]; then
        dir=$(<"$tmp")
        rm -f "$tmp" >/dev/null
        [[ -d "$dir" && "$dir" != "$PWD" ]] && cd -- "$dir"
    fi
}

fcd() {
    local dir
    dir=$(find . -type d | fzf --layout=reverse) || return
    cd -- "$dir"
}


# ── Personal shortcuts ───────────────────────────────────────

bindkey -s '^p' 'pulsemixer\n'
bindkey -s '^o' 'lfcd\n'
bindkey -s '^a' 'bc -lq\n'
bindkey -s '^f' 'fcd\n'

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^v' edit-command-line

bindkey -s '^e' '$EDITOR\n'
