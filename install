#!/bin/bash
# ============================================================
# Arch Linux / Artix Linux + Sway: install
#
# Run as the normal user:   ./install
# Expects the repository at ~/.dotfiles.
# Arch uses systemd, Artix uses runit.
#
# TO UPDATE LATER (only the top of this file normally changes):
#   - new package        -> add it to a PKGS_* or AUR_PKGS list
#   - new config symlink -> add a line to a LINKS_* list
#   - new service        -> SYSTEMD_* lists, or RUNIT_PKGS_* lists
# ============================================================

set -e

DOTFILES="$HOME/.dotfiles"

# ============================================================
# 1. PACKAGE LISTS
# ============================================================

# Both machines, both distributions.
PKGS_COMMON=(
    7zip autotiling base base-devel bat bc bluetui bluez bluez-utils
    brightnessctl chafa cliphist cups cups-pk-helper efibootmgr exiv2
    expac eza fastfetch fatsort fd foot fuzzel fzf gdu git grim
    gst-plugin-pipewire gvfs gvfs-mtp highlight imagemagick jq
    kdeconnect keepassxc lf libjpeg-turbo libpulse libreoffice-still
    libretro-core-info libretro-genesis-plus-gx libretro-mgba
    libretro-overlays libretro-snes9x libva-utils mako man-db
    mediainfo mkinitcpio moreutils mpv mpv-mpris neovim newsboat
    nicotine+ nmap noto-fonts noto-fonts-cjk noto-fonts-emoji ntfs-3g
    odt2txt openssh otf-font-awesome otf-hermit pamixer pass
    pipewire pipewire-alsa pipewire-jack pipewire-pulse playerctl
    python-adblock python-pykeepass qutebrowser reaper retroarch
    retroarch-assets-ozone ripgrep rsync scrcpy slurp smartmontools
    sshfs sudo sway swaybg swappy swayidle swayimg swaylock syncthing
    system-config-printer tmux torbrowser-launcher translate-shell
    tree ttf-dejavu ttf-liberation ufw unrar unzip urlscan w3m waybar
    wdisplays wf-recorder wget wiremix wireplumber wl-clipboard wlopm
    wlsunset wmenu woff2-font-awesome wtype xdg-utils xorg-xwayland
    yt-dlp zathura zathura-pdf-mupdf zip zoxide zsh zsh-autosuggestions
    zsh-completions zsh-history-substring-search zsh-syntax-highlighting
)

# Desktop PC (AMD).
PKGS_PC=(
    amd-ucode btop calibre cdrtools chromium csound figlet gimp
    kdenlive mpc mpd mpd-mpris mpdscribble nano networkmanager
    pavucontrol pfetch-rs python-docx python-matplotlib python-mpd2
    python-openpyxl python-pandas python-pedalboard python-pip
    python-pipx python-pydbus python-soundfile python-xlrd
    qbittorrent reapack rmpc sox systemctl-tui thunderbird typst
    virtualbox virtualbox-guest-iso vulkan-radeon webkit2gtk-4.1
    wpa_supplicant xf86-video-amdgpu xf86-video-ati ydotool
)

# Arch only, both machines (an Artix base install chooses its own kernel).
PKGS_ARCH=(linux-zen linux-zen-headers linux-firmware)

# Laptop (Intel).
PKGS_LAPTOP=(
    batsignal bluez-plugins cropgui dhcpcd intel-ucode iwd pcmanfm
)

# Arch laptop only (Artix deliberately skips power management).
PKGS_ARCH_LAPTOP=(cpupower powertop thermald tlp tlp-rdw)

# Artix only: runit service definitions, common to both machines.
PKGS_ARTIX=(bluez-runit cups-runit ufw-runit rsm)
PKGS_ARTIX_LAPTOP=(dhcpcd-runit iwd-runit)

# AUR (yay also accepts repo packages). One by one, so a failure
# does not stop the rest.
AUR_PKGS=(
    batdoc-bin duckstation-qt-bin fsearch google-chrome htop-vim mdcat
    nvimpager pass-import pmount puddletag task-spooler timr-bin
    waterfox-bin wayclip zapzap
)

# ============================================================
# 2. SERVICES
#
# PC networking: NetworkManager. It is enabled, but the installer
# never restarts it, so the connection does not drop.
# ============================================================

SYSTEMD_NOW_COMMON=(bluetooth.service cups.service)
SYSTEMD_NOW_LAPTOP=(dhcpcd.service iwd.service)
SYSTEMD_KEEP_PC=(NetworkManager.service)
SYSTEMD_ENABLE=(ufw.service)

# systemd user services, PC only
SYSTEMD_USER_PC=(mpd.service)

# runit services are resolved from these packages
RUNIT_PKGS_COMMON=(bluez-runit cups-runit ufw-runit)
RUNIT_PKGS_LAPTOP=(dhcpcd-runit iwd-runit)

# ============================================================
# 3. SYMLINK LISTS
#
# "path inside ~/.dotfiles : path inside $HOME"
# @MACHINE@ becomes "laptop" or "pc". Real files in the way are
# renamed to *.bak.TIMESTAMP, never deleted.
# ============================================================

LINKS_COMMON=(
    "zshenv:.zshenv"
    "config/zsh/zshrc:.config/zsh/.zshrc"
    "config/zsh/zprofile:.config/zsh/.zprofile"
    "config/fontconfig:.config/fontconfig"
    "config/git:.config/git"
    "config/gtk-2.0:.config/gtk-2.0"
    "config/gtk-3.0:.config/gtk-3.0"
    "config/htop/htoprc:.config/htop/htoprc"
    "config/lf:.config/lf"
    "config/lf/preview:.local/bin/preview"
    "config/mako:.config/mako"
    "config/mpv/input.conf:.config/mpv/input.conf"
    "config/mpv/mpv.conf:.config/mpv/mpv.conf"
    "config/mpv/librefmscrobbler.lua:.config/mpv/librefmscrobbler.lua"
    "config/newsboat/config:.config/newsboat/config"
    "config/nvim:.config/nvim"
    "config/qutebrowser/config.py:.config/qutebrowser/config.py"
    "config/qutebrowser/greasemonkey:.config/qutebrowser/greasemonkey"
    "config/shell/aliasrc:.config/shell/aliasrc"
    "config/shell/functionrc:.config/shell/functionrc"
    "config/shell/shortcutrc:.config/shell/shortcutrc"
    "config/shell/@MACHINE@:.config/shell/@MACHINE@"
    "config/swayimg:.config/swayimg"
    "config/tmux/tmux.conf:.config/tmux/tmux.conf"
    "config/urlscan:.config/urlscan"
    "config/zathura:.config/zathura"
    # Machine-specific variants
    "config/foot/foot.ini.@MACHINE@:.config/foot/foot.ini"
    "config/fuzzel/fuzzel.ini.@MACHINE@:.config/fuzzel/fuzzel.ini"
    "config/sway/config.@MACHINE@:.config/sway/config"
    "config/waybar/config.jsonc.@MACHINE@:.config/waybar/config.jsonc"
    "config/waybar/style.css.@MACHINE@:.config/waybar/style.css"
    # ~/.local/share
    "share/applications:.local/share/applications"
    "share/wallpapers:.local/share/wallpapers"
    "share/sound-notifications/batterylow.opus:.local/share/sound-notifications/batterylow.opus"
)

LINKS_PC=(
    "config/mpd/mpd.conf:.config/mpd/mpd.conf"
    "config/rmpc:.config/rmpc"
)

LINKS_LAPTOP=()

# ============================================================
# 4. HELPERS
# ============================================================

info()    { printf '\033[1;34m==> %s\033[0m\n' "$1"; }
success() { printf '\033[1;32m==> %s\033[0m\n' "$1"; }
error()   { printf '\033[1;31m==> %s\033[0m\n' "$1" >&2; }

# A wrong symlink is replaced; a real file or directory is moved aside.
link() {
    local src="$DOTFILES/$1" dst="$HOME/$2"

    if [ ! -e "$src" ]; then
        error "Missing in the repository, skipped: $1"
        return 0
    fi

    mkdir -p "$(dirname "$dst")"

    if [ -L "$dst" ]; then
        [ "$(readlink "$dst")" = "$src" ] && return 0
        rm "$dst"
    elif [ -e "$dst" ]; then
        mv "$dst" "$dst.bak.$(date +%s)"
        info "Backed up existing $2"
    fi

    ln -s "$src" "$dst"
}

link_all() {
    local entry
    for entry in "$@"; do
        entry="${entry//@MACHINE@/$MACHINE}"
        link "${entry%%:*}" "${entry#*:}"
    done
}

# runit directory names do not always match the package name
# (bluez-runit provides "bluetoothd"), so read them from the package.
runit_service_name() {
    pacman -Qlq "$1" 2>/dev/null \
        | grep -E '^/etc/runit/sv/[^/]+/$' \
        | head -n1 \
        | sed -E 's#^/etc/runit/sv/([^/]+)/$#\1#'
}

enable_runit_service() {
    local svc
    svc="$(runit_service_name "$1")"

    if [ -z "$svc" ]; then
        error "Could not determine the runit service provided by $1"
        return 1
    fi

    if [ ! -e "/run/runit/service/$svc" ]; then
        info "Enabling runit service: $svc"
        sudo ln -s "/etc/runit/sv/$svc" "/run/runit/service/$svc"
    fi
}

# ============================================================
# 5. CHECKS
# ============================================================

if [ "$EUID" -eq 0 ]; then
    error "Do not run this script as root."
    exit 1
fi

if ! command -v pacman >/dev/null 2>&1; then
    error "This does not appear to be an Arch-based system."
    exit 1
fi

if [ ! -d "$DOTFILES" ]; then
    error "Dotfiles directory not found: $DOTFILES"
    error "Clone your repository first."
    exit 1
fi

# On a fresh manual install the user is not in sudoers yet. Fix it
# as root first:
#     usermod -aG wheel <user>
#     EDITOR=nvim visudo     # uncomment %wheel ALL=(ALL:ALL) ALL
if ! sudo -v 2>/dev/null; then
    error "This user does not have sudo access yet."
    error "Fix this as root before running the installer, e.g.:"
    error "  usermod -aG wheel $USER"
    error "  EDITOR=nvim visudo   # uncomment %wheel ALL=(ALL:ALL) ALL"
    exit 1
fi

if ! id -nG "$USER" | tr ' ' '\n' | grep -qx wheel; then
    sudo usermod -aG wheel "$USER"
fi

if [ -d /run/runit/service ]; then
    INIT="runit"
elif [ "$(ps -p 1 -o comm=)" = "systemd" ]; then
    INIT="systemd"
else
    error "Could not determine the init system (supported: systemd, runit)."
    exit 1
fi

if [ -f /etc/os-release ]; then
    . /etc/os-release
else
    error "Could not determine the operating system."
    exit 1
fi

case "$ID" in
    arch)  DISTRO="arch" ;;
    artix) DISTRO="artix" ;;
    *)
        error "Unsupported distribution: $ID (supported: Arch, Artix)"
        exit 1
        ;;
esac

if [ "$DISTRO" = "arch" ] && [ "$INIT" != "systemd" ]; then
    error "Arch Linux was detected without systemd."
    exit 1
fi

if [ "$DISTRO" = "artix" ] && [ "$INIT" != "runit" ]; then
    error "Artix Linux was detected without runit."
    exit 1
fi

info "Detected $DISTRO with $INIT"

# ============================================================
# 6. PACMAN
# ============================================================

info "Configuring pacman"

sudo sed -i \
    -e 's/^[[:space:]]*#\?[[:space:]]*Color[[:space:]]*$/Color/' \
    -e 's/^[[:space:]]*#\?[[:space:]]*ParallelDownloads[[:space:]]*=.*$/ParallelDownloads = 10/' \
    /etc/pacman.conf

# Artix has no access to Arch's repositories by default. Every package
# below must exist on both, so enable Arch's extra and multilib first.
# See https://wiki.artixlinux.org/Main/Repositories
if [ "$DISTRO" = "artix" ] && ! grep -q '^\[extra\]' /etc/pacman.conf; then

    info "Enabling Arch Linux repositories on Artix"

    sudo pacman -S --needed artix-archlinux-support
    sudo pacman-key --populate archlinux

    sudo tee -a /etc/pacman.conf >/dev/null <<'EOF'

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
EOF

    sudo pacman -Syu
fi

# ============================================================
# 7. MACHINE TYPE
# ============================================================

printf '\nSelect installation type:\n  1) Laptop\n  2) Desktop PC\n\n'

while true; do
    read -r -p "Choice [1-2]: " INSTALL_TYPE
    case "$INSTALL_TYPE" in
        1) LAPTOP=true;  MACHINE="laptop"; break ;;
        2) LAPTOP=false; MACHINE="pc";     break ;;
        *) echo "Please enter 1 or 2." ;;
    esac
done

# Laptop = Intel, desktop = AMD. Safety check.
CPU_VENDOR="$(lscpu | awk -F: '/Vendor ID:/ {gsub(/^[ \t]+/, "", $2); print $2}')"

if [ "$LAPTOP" = true ] && [ "$CPU_VENDOR" != "GenuineIntel" ]; then
    error "The laptop installation expects an Intel CPU (found: $CPU_VENDOR)."
    exit 1
fi

if [ "$LAPTOP" = false ] && [ "$CPU_VENDOR" != "AuthenticAMD" ]; then
    error "The desktop PC installation expects an AMD CPU (found: $CPU_VENDOR)."
    exit 1
fi

# ============================================================
# 8. PACKAGES
# ============================================================

info "Installing packages from the official repositories"

PKGS=("${PKGS_COMMON[@]}")

if [ "$LAPTOP" = true ]; then
    PKGS+=("${PKGS_LAPTOP[@]}")
    [ "$DISTRO" = "arch" ] && PKGS+=("${PKGS_ARCH_LAPTOP[@]}")
else
    PKGS+=("${PKGS_PC[@]}")
fi

if [ "$DISTRO" = "arch" ]; then
    PKGS+=("${PKGS_ARCH[@]}")
fi

if [ "$DISTRO" = "artix" ]; then
    PKGS+=("${PKGS_ARTIX[@]}")
    [ "$LAPTOP" = true ] && PKGS+=("${PKGS_ARTIX_LAPTOP[@]}")
fi

sudo pacman -S --needed "${PKGS[@]}"

if ! command -v yay >/dev/null 2>&1; then
    info "Installing yay"
    tmpdir="$(mktemp -d)"
    git clone https://aur.archlinux.org/yay-bin.git "$tmpdir/yay-bin"
    ( cd "$tmpdir/yay-bin" && makepkg -si --noconfirm )
    rm -rf "$tmpdir"
fi

info "Installing packages from the AUR"

AUR_FAILED=()
for pkg in "${AUR_PKGS[@]}"; do
    yay -S --needed --noconfirm "$pkg" || {
        error "Failed to install AUR package: $pkg"
        AUR_FAILED+=("$pkg")
    }
done

if [ "${#AUR_FAILED[@]}" -gt 0 ]; then
    error "AUR packages that failed: ${AUR_FAILED[*]}"
    error "Continuing with the rest of the installation."
fi

# ============================================================
# 9. SERVICES
#
# elogind-runit (needed by Sway under runit) is expected to be
# enabled already by the manual Artix base install.
# ============================================================

SYSTEMD_NOW=("${SYSTEMD_NOW_COMMON[@]}")
RUNIT_PKGS=("${RUNIT_PKGS_COMMON[@]}")

if [ "$LAPTOP" = true ]; then
    SYSTEMD_NOW+=("${SYSTEMD_NOW_LAPTOP[@]}")
    RUNIT_PKGS+=("${RUNIT_PKGS_LAPTOP[@]}")
fi

if [ "$INIT" = "systemd" ]; then

    info "Enabling systemd services"

    for unit in "${SYSTEMD_NOW[@]}"; do
        sudo systemctl enable --now "$unit"
    done
    for unit in "${SYSTEMD_ENABLE[@]}"; do
        sudo systemctl enable "$unit"
    done

    if [ "$LAPTOP" = false ]; then
        for unit in "${SYSTEMD_KEEP_PC[@]}"; do
            sudo systemctl enable --now "$unit"
        done
    fi

else

    info "Enabling runit services"

    for pkg in "${RUNIT_PKGS[@]}"; do
        enable_runit_service "$pkg"
    done

fi

# ============================================================
# 10. AUTOLOGIN ON TTY1 (systemd)
#
# No display manager: tty1 logs in automatically and zprofile
# starts Sway. On Artix this is part of the base install.
# ============================================================

if [ "$INIT" = "systemd" ]; then

    info "Configuring tty1 autologin for $USER"

    sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
    sudo tee /etc/systemd/system/getty@tty1.service.d/autologin.conf >/dev/null <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\u' --noclear --autologin @USER@ - $TERM
EOF
    sudo sed -i "s/@USER@/$USER/" \
        /etc/systemd/system/getty@tty1.service.d/autologin.conf
fi

# ============================================================
# 11. UFW
# ============================================================

info "Configuring UFW"

sudo ufw allow 1714:1764/udp     # KDE Connect
sudo ufw allow 1714:1764/tcp
sudo ufw allow ssh
sudo ufw logging off
sudo ufw --force enable
sudo ufw reload

# ============================================================
# 12. SYSTEMD-JOURNALD (Arch only)
# ============================================================

if [ "$INIT" = "systemd" ]; then

    info "Configuring systemd-journald"

    sudo mkdir -p /etc/systemd/journald.conf.d
    sudo tee /etc/systemd/journald.conf.d/99-reduce-journal-writes.conf >/dev/null <<'EOF'
[Journal]
Storage=volatile
SystemMaxUse=50M
ForwardToSyslog=no
EOF
    sudo systemctl restart systemd-journald
fi

# ============================================================
# 13. SUDOERS (passwordless commands used by the dotfiles)
# ============================================================

info "Configuring sudoers"

sudo tee /etc/sudoers.d/passwordless-commands >/dev/null <<EOF
$USER ALL=(ALL) NOPASSWD: $(command -v pacman), $(command -v reboot), $(command -v poweroff), $(command -v nvim)
EOF

sudo chmod 440 /etc/sudoers.d/passwordless-commands
sudo visudo -cf /etc/sudoers.d/passwordless-commands

# ============================================================
# 14. DOTFILES
# ============================================================

info "Linking configuration"

link_all "${LINKS_COMMON[@]}"

if [ "$LAPTOP" = true ]; then
    link_all "${LINKS_LAPTOP[@]}"
else
    link_all "${LINKS_PC[@]}"
fi

# Local state that is not version-controlled.
mkdir -p "$HOME/.cache/zsh"
touch "$HOME/.cache/zsh/history"

mkdir -p "$HOME/.local/share/password-store" "$HOME/.local/share/gnupg"
chmod 700 "$HOME/.local/share/password-store" "$HOME/.local/share/gnupg"

if [ "$LAPTOP" = false ]; then
    # mpdscribble state (its config, with credentials, stays local);
    # librefm.journal belongs to librefmscrobbler.
    mkdir -p "$HOME/.local/cache" "$HOME/.local/share/mpdscribble"
    touch "$HOME/.local/cache/librefm.journal"

    # MPD runs as a user service (needs a normal login session).
    mkdir -p "$HOME/.config/mpd/playlists"
    if [ "$INIT" = "systemd" ]; then
        for unit in "${SYSTEMD_USER_PC[@]}"; do
            systemctl --user enable --now "$unit" \
                || error "Could not enable $unit; later run: systemctl --user enable --now $unit"
        done
    fi
fi

# Neovim plugins, at the versions pinned in lazy-lock.json.
info "Installing Neovim plugins"
nvim --headless "+Lazy! restore" +qa \
    || error "Neovim plugin install failed; open nvim once to finish it."

xdg-mime default lf.desktop inode/directory

info "Changing the login shell to Zsh"
chsh -s "$(command -v zsh)" "$USER"

# ============================================================
# 15. ARCH LAPTOP: POWER MANAGEMENT
# ============================================================

if [ "$LAPTOP" = true ] && [ "$DISTRO" = "arch" ]; then

    info "Configuring TLP and thermald"

    sudo systemctl enable tlp.service

    # power-profiles-daemon must not run next to TLP.
    if systemctl list-unit-files | grep -q '^power-profiles-daemon.service'; then
        sudo systemctl disable --now power-profiles-daemon.service || true
    fi

    # No USB autosuspend for the M-Audio Fast Track Pro.
    sudo mkdir -p /etc/tlp.d
    sudo tee /etc/tlp.d/10-audio.conf >/dev/null <<'EOF'
USB_DENYLIST="0763:2012"
EOF
    sudo tlp start

    sudo systemctl enable --now thermald.service

    # Powertop stays installed for manual use, not as a service.
    sudo systemctl disable --now powertop.service 2>/dev/null || true

    # Block only the Bluetooth radio; bluetooth.service keeps running.
    sudo tee /etc/systemd/system/bluetooth-block.service >/dev/null <<'EOF'
[Unit]
Description=Block Bluetooth radio
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/bin/rfkill block bluetooth
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

    sudo systemctl daemon-reload
    sudo systemctl enable bluetooth-block.service
fi

# ============================================================
# 16. ARTIX LAPTOP
#
# No TLP/thermald stack: battery life is better without it on
# this hardware. elogind does not manage backlight permissions
# here, so the "video" group and a udev rule do it. bluetoothd
# starts only on demand.
# ============================================================

if [ "$LAPTOP" = true ] && [ "$DISTRO" = "artix" ]; then

    if ! id -nG "$USER" | tr ' ' '\n' | grep -qx video; then
        sudo usermod -aG video "$USER"
    fi

    sudo tee /etc/udev/rules.d/90-backlight.rules >/dev/null <<'EOF'
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
EOF

    sudo udevadm control --reload-rules
    sudo udevadm trigger --subsystem-match=backlight

    sudo touch /etc/runit/runsvdir/default/bluetoothd/down
fi

# ============================================================
# 17. FINALIZATION
# ============================================================

info "Refreshing font cache"
fc-cache -f

if [ "$INIT" = "systemd" ]; then

    sudo systemctl daemon-reload

    for unit in "${SYSTEMD_NOW[@]}"; do
        sudo systemctl restart "$unit"
    done

    if [ "$LAPTOP" = true ] && [ "$DISTRO" = "arch" ]; then
        sudo systemctl start bluetooth-block.service
    fi

else

    for pkg in "${RUNIT_PKGS[@]}"; do
        svc="$(runit_service_name "$pkg")"
        if [ -n "$svc" ] && [ -e "/run/runit/service/$svc" ]; then
            sudo sv restart "$svc" 2>/dev/null || true
        fi
    done

fi

success "Completed."
