#!/bin/bash

set -e

echo "========================================="
echo " Installing personal Arch Linux setup"
echo "========================================="
echo

# ---------------------------------------------------------
# Update package database
# ---------------------------------------------------------

echo "Updating package database..."
sudo pacman -Syu --needed

# ---------------------------------------------------------
# Sway / Wayland environment
# ---------------------------------------------------------

echo
echo "Installing Sway / Wayland environment..."

sudo pacman -S --needed \
    sway \
    foot \
    waybar \
    mako \
    fuzzel \
    swayimg \
    grim \
    slurp \
    wdisplays \
    wlsunset \
    wtype \
    wl-clipboard \
    brightnessctl \
    playerctl \
    cliphist

# ---------------------------------------------------------
# Audio
# ---------------------------------------------------------

echo
echo "Installing audio utilities..."

sudo pacman -S --needed \
    pamixer \
    pulsemixer \
    cava \
    ffmpeg

# ---------------------------------------------------------
# Fonts
# ---------------------------------------------------------

echo
echo "Installing fonts..."

sudo pacman -S --needed \
    otf-hermit

# ---------------------------------------------------------
# Terminal / CLI utilities
# ---------------------------------------------------------

echo
echo "Installing command-line utilities..."

sudo pacman -S --needed \
    7zip \
    bat \
    bc \
    eza \
    fd \
    fzf \
    highlight \
    lf \
    moreutils \
    ncdu \
    ripgrep \
    rsync \
    wget \
    zip

# ---------------------------------------------------------
# File / media utilities
# ---------------------------------------------------------

echo
echo "Installing file and media utilities..."

sudo pacman -S --needed \
    fatsort \
    mediainfo \
    ntfs-3g \
    docx2txt \
    odt2txt

# ---------------------------------------------------------
# System information / monitoring
# ---------------------------------------------------------

echo
echo "Installing system utilities..."

sudo pacman -S --needed \
    fastfetch \
    hwinfo \
    powertop \
    cpupower

# ---------------------------------------------------------
# Network / desktop integration
# ---------------------------------------------------------

echo
echo "Installing desktop integration utilities..."

sudo pacman -S --needed \
    network-manager-applet \
    kdeconnect

# ---------------------------------------------------------
# Services / utilities
# ---------------------------------------------------------

echo
echo "Installing utilities and services..."

sudo pacman -S --needed \
    syncthing \
    batsignal \
    tlp-rdw \
    thermald \
    ufw

# ---------------------------------------------------------
# Printing
# ---------------------------------------------------------

echo
echo "Installing printing support..."

sudo pacman -S --needed \
    cups \
    system-config-printer

# ---------------------------------------------------------
# Browsers / terminal web tools
# ---------------------------------------------------------

echo
echo "Installing web utilities..."

sudo pacman -S --needed \
    qutebrowser \
    w3m

# ---------------------------------------------------------
# Music / recording
# ---------------------------------------------------------

echo
echo "Installing music and recording software..."

sudo pacman -S --needed \
    reaper

# ---------------------------------------------------------
# Android / device utilities
# ---------------------------------------------------------

echo
echo "Installing device utilities..."

sudo pacman -S --needed \
    scrcpy

# ---------------------------------------------------------
# Password management
# ---------------------------------------------------------

echo
echo "Installing password management tools..."

sudo pacman -S --needed \
    pass

# ---------------------------------------------------------
# AUR helper
# ---------------------------------------------------------

echo
echo "Installing yay..."

if ! command -v yay >/dev/null 2>&1; then
    tmpdir=$(mktemp -d)

    git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"

    (
        cd "$tmpdir/yay"
        makepkg -si --noconfirm
    )

    rm -rf "$tmpdir"
else
    echo "yay is already installed."
fi

# ---------------------------------------------------------
# AUR packages
# ---------------------------------------------------------

echo
echo "Installing selected AUR packages..."

yay -S --needed \
    timr-bin \
    ttf-romande \
    wayclip

# ---------------------------------------------------------
# Optional packages
# ---------------------------------------------------------
#
# The original install had these packages that may be
# installed manually later:
#
# qBittorrent
# LibreWolf
# Nicotine+
# Tor Browser Launcher
# RetroArch
# DuckStation
#
# Hardware-specific packages / utilities:
#
# cpupower
# hwinfo
# intel-ucode
# thermald
# tlp-rdw
#
# Other packages from the original installation were
# intentionally left out because they are either:
#
# - part of the Archinstall/base installation
# - hardware-specific
# - development/build dependencies
# - temporary dependencies
# - optional software
# - no longer used
#
# ---------------------------------------------------------

sudo tee /etc/sudoers.d/passwordless-commands > /dev/null <<'EOF'
mrcl ALL=(ALL) NOPASSWD: /bin/pacman, /bin/reboot, /bin/poweroff, /bin/su, /bin/nvim
EOF

sudo chmod 440 /etc/sudoers.d/passwordless-commands
sudo visudo -cf /etc/sudoers.d/passwordless-commands

# ---------------------------------------------------------

echo
echo "========================================="
echo " Installation complete."
echo "========================================="
echo
echo "You may want to reboot before using the"
echo "complete Sway environment."
echo
