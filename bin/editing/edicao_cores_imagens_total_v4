#!/bin/bash

INPUT_PATTERN="*.jpg"
BASE_DIR="resultados_analogicos"
JOBS=8   # ajuste conforme sua CPU (ex: 4, 6, 8)

mkdir -p "$BASE_DIR"

# Lista de arquivos
files=$(ls $INPUT_PATTERN 2>/dev/null)

# =====================================
# Função helper
# =====================================
run_parallel () {
  outdir="$1"
  shift
  mkdir -p "$outdir"
  printf "%s\n" $files | xargs -P $JOBS -I {} magick "{}" "$@" "$outdir/{}"
}

# =====================================
# 1. color_iso_alto
# =====================================
run_parallel "$BASE_DIR/color_iso_alto" \
  -modulate 110,150,100 \
  -level 5%,95% \
  -channel R -evaluate multiply 0.90 +channel \
  -attenuate 1.0 +noise Gaussian \
  -sigmoidal-contrast 5,50%

# =====================================
# 2. pb_analogico
# =====================================
run_parallel "$BASE_DIR/pb_analogico" \
  -colorspace RGB -colorspace Gray \
  -level 20%,85% \
  -sigmoidal-contrast 10,40% \
  -attenuate 0.5 +noise Gaussian \
  -ordered-dither o8x8

# =====================================
# 3. pb_lofi
# =====================================
run_parallel "$BASE_DIR/pb_lofi" \
  -colorspace RGB -colorspace Gray \
  -level 15%,90% \
  -sigmoidal-contrast 6,50% \
  -attenuate 0.3 +noise Gaussian \
  -ordered-dither o4x4

# =====================================
# 4. xerox_sujo
# =====================================
run_parallel "$BASE_DIR/xerox_sujo" \
  -colorspace RGB -colorspace Gray \
  -level 25%,85% \
  -sigmoidal-contrast 12,35% \
  -attenuate 0.8 +noise Gaussian \
  -ordered-dither o8x8

# =====================================
# 5. color_cross_process
# =====================================
run_parallel "$BASE_DIR/color_cross_process" \
  -modulate 105,130,100 \
  -color-matrix "1.05 0.05 -0.05 -0.05 1.05 0.05 0.05 -0.05 1.05" \
  -level 6%,94% \
  -channel R -evaluate multiply 0.88 +channel \
  -sigmoidal-contrast 5,50% \
  -attenuate 0.25 +noise Gaussian

# =====================================
# 6. color_fade_cinematico
# =====================================
run_parallel "$BASE_DIR/color_fade_cinematico" \
  -modulate 95,85,100 \
  -level 10%,98% \
  -gamma 1.1 \
  -channel R -evaluate multiply 0.92 +channel \
  -sigmoidal-contrast 3,60% \
  -gaussian-blur 0x0.8 \
  -attenuate 0.2 +noise Gaussian

# =====================================
# 7. color_flash_2000
# =====================================
run_parallel "$BASE_DIR/color_flash_2000" \
  -modulate 115,120,100 \
  -level 12%,88% \
  -channel R -evaluate multiply 0.90 +channel \
  -sigmoidal-contrast 7,45% \
  -attenuate 0.3 +noise Gaussian

echo "Processamento concluído (paralelo)."

