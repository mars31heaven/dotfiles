#!/bin/bash

# Cria a pasta de saída se não existir (opcional, para organização)
# mkdir -p convertidos

for arquivo in *.mp4; do
    # Pula arquivos que já terminam com _reduzido para evitar loops
    [[ "$arquivo" == *"_reduzido.mp4" ]] && continue

    nome_base="${arquivo%.mp4}"
    
    echo "Processando: $arquivo"
    
    ffmpeg -i "$arquivo" -c:v libx265 -crf 22 -preset slow -c:a copy "${nome_base}_reduzido.mp4"
done

echo "Conversão concluída!"!/bin/sh
