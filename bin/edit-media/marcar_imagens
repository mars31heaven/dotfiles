#!/bin/sh

mkdir -p marcadas
for img in *.jpg; do
  # 1. Mede a largura da imagem
  width=$(identify -format "%w" "$img")
  
  # 2. Fonte reduzida em 30% (de 0.06 para 0.04 da largura)
  font_size=$(echo "$width * 0.04" | bc)
  
  # 3. Tarja mantida em 70% da largura da foto
  box_width=$(echo "$width * 0.70" | bc)

  magick "$img" \
    \( -size "${box_width}x" \
       -background "rgba(0,0,0,0.3)" \
       -fill "white" \
       -pointsize "$font_size" \
       -gravity Center \
       caption:"NEGOCIAR SOMENTE C/ MARCELO.\nINSTAGRAM @marsaruido" \
       -bordercolor "rgba(0,0,0,0.3)" -border 15 \
    \) -gravity Center -composite \
    "marcadas/$img"
done
