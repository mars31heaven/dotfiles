#!/bin/bash

INPUT="*.jpg"
BASE_DIR="resultados_analogicos"

mkdir -p "$BASE_DIR"

# =====================================
# FUNÇÃO BASE (controle de vermelho leve)
# =====================================
RED_FIX="-channel R -evaluate multiply 0.88 +channel"

# =====================================
# 1. color_analogico_forte
# =====================================
mkdir -p "$BASE_DIR/color_analogico_forte"
magick mogrify -path "$BASE_DIR/color_analogico_forte" -format jpg \
  -modulate 110,170,100 \
  -colorspace RGB -level 5%,95% \
  $RED_FIX \
  -sigmoidal-contrast 6,50% \
  -gaussian-blur 0x1.5 \
  -attenuate 0.3 +noise Gaussian \
  $INPUT

# =====================================
# 2. color_estourado_2000
# =====================================
mkdir -p "$BASE_DIR/color_estourado_2000"
magick mogrify -path "$BASE_DIR/color_estourado_2000" -format jpg \
  -modulate 130,200,100 \
  -colorspace RGB -level 10%,90% \
  $RED_FIX \
  -sigmoidal-contrast 8,40% \
  -gaussian-blur 0x2 \
  -evaluate add 8% \
  -attenuate 0.5 +noise Gaussian \
  $INPUT

# =====================================
# 3. color_glow_lofi
# =====================================
mkdir -p "$BASE_DIR/color_glow_lofi"
magick mogrify -path "$BASE_DIR/color_glow_lofi" -format jpg \
  -modulate 115,180,100 \
  -colorspace RGB -level 8%,92% \
  $RED_FIX \
  -gaussian-blur 0x3 \
  -sigmoidal-contrast 4,50% \
  -attenuate 0.4 +noise Gaussian \
  $INPUT

# =====================================
# 4. color_distorcido
# =====================================
mkdir -p "$BASE_DIR/color_distorcido"
magick mogrify -path "$BASE_DIR/color_distorcido" -format jpg \
  -modulate 120,190,100 \
  -colorspace RGB -level 5%,95% \
  $RED_FIX \
  -wave 2x40 \
  -sigmoidal-contrast 6,50% \
  -attenuate 0.3 +noise Gaussian \
  $INPUT

# =====================================
# 5. color_super_estourado
# =====================================
mkdir -p "$BASE_DIR/color_super_estourado"
magick mogrify -path "$BASE_DIR/color_super_estourado" -format jpg \
  -modulate 140,220,100 \
  -level 15%,85% \
  $RED_FIX \
  -gaussian-blur 0x4 \
  -evaluate add 10% \
  -attenuate 0.6 +noise Gaussian \
  $INPUT

# =====================================
# 6. color_iso_alto
# =====================================
mkdir -p "$BASE_DIR/color_iso_alto"
magick mogrify -path "$BASE_DIR/color_iso_alto" -format jpg \
  -modulate 110,150,100 \
  -level 5%,95% \
  $RED_FIX \
  -attenuate 1.0 +noise Gaussian \
  -sigmoidal-contrast 5,50% \
  $INPUT

# =====================================
# 7. color_glitch
# =====================================
mkdir -p "$BASE_DIR/color_glitch"
magick mogrify -path "$BASE_DIR/color_glitch" -format jpg \
  -modulate 130,200,100 \
  -level 10%,90% \
  $RED_FIX \
  -wave 3x60 \
  -gaussian-blur 0x2 \
  -attenuate 0.5 +noise Gaussian \
  $INPUT

# =====================================
# 8. color_opaco_controlado (já existente)
# =====================================
mkdir -p "$BASE_DIR/color_opaco_controlado"
magick mogrify -path "$BASE_DIR/color_opaco_controlado" -format jpg \
  -modulate 105,120,100 \
  -colorspace RGB \
  -channel R -evaluate multiply 0.85 +channel \
  -level 8%,92% \
  -sigmoidal-contrast 5,50% \
  -gaussian-blur 0x1 \
  -attenuate 0.2 +noise Gaussian \
  $INPUT

# =====================================
# 9. NOVO — color_opaco_apagado (mais desbotado)
# =====================================
mkdir -p "$BASE_DIR/color_opaco_apagado"
magick mogrify -path "$BASE_DIR/color_opaco_apagado" -format jpg \
  -modulate 90,80,100 \
  -colorspace RGB \
  -channel R -evaluate multiply 0.85 +channel \
  -level 12%,98% \
  -sigmoidal-contrast 3,60% \
  -gaussian-blur 0x1 \
  -attenuate 0.2 +noise Gaussian \
  $INPUT

# =====================================
# 10. color_adaptativo (HSL inteligente)
# =====================================
mkdir -p "$BASE_DIR/color_adaptativo"

for img in $INPUT; do
  magick "$img" \
    -colorspace HSL \
    -channel G \
    -fx "u*0.8 + 0.2*(1-u)" \
    +channel \
    -colorspace RGB \
    -channel R -evaluate multiply 0.85 +channel \
    -modulate 110,140,100 \
    -level 6%,94% \
    -sigmoidal-contrast 6,50% \
    -gaussian-blur 0x1.2 \
    -attenuate 0.25 +noise Gaussian \
    "$BASE_DIR/color_adaptativo/$img"
done

# =====================================
# PB (mantidos iguais)
# =====================================

mkdir -p "$BASE_DIR/pb_analogico"
magick mogrify -path "$BASE_DIR/pb_analogico" -format jpg \
  -colorspace RGB -colorspace Gray \
  -level 20%,85% \
  -sigmoidal-contrast 10,40% \
  -attenuate 0.5 +noise Gaussian \
  -ordered-dither o8x8 \
  $INPUT

mkdir -p "$BASE_DIR/xerox_pesado"
magick mogrify -path "$BASE_DIR/xerox_pesado" -format jpg \
  -colorspace RGB -colorspace Gray \
  -level 30%,80% \
  -threshold 55% \
  -ordered-dither o8x8 \
  $INPUT

mkdir -p "$BASE_DIR/xerox_sujo"
magick mogrify -path "$BASE_DIR/xerox_sujo" -format jpg \
  -colorspace RGB -colorspace Gray \
  -level 25%,85% \
  -sigmoidal-contrast 12,35% \
  -attenuate 0.8 +noise Gaussian \
  -ordered-dither o8x8 \
  $INPUT

mkdir -p "$BASE_DIR/pb_lofi"
magick mogrify -path "$BASE_DIR/pb_lofi" -format jpg \
  -colorspace RGB -colorspace Gray \
  -level 15%,90% \
  -sigmoidal-contrast 6,50% \
  -attenuate 0.3 +noise Gaussian \
  -ordered-dither o4x4 \
  $INPUT

mkdir -p "$BASE_DIR/pb_fotografico"
magick mogrify -path "$BASE_DIR/pb_fotografico" -format jpg \
  -colorspace RGB -colorspace Gray \
  -level 10%,90% \
  -sigmoidal-contrast 14,50% \
  -attenuate 0.2 +noise Gaussian \
  $INPUT

echo "Todos os efeitos aplicados."
