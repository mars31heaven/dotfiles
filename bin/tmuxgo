#!/usr/bin/env sh
#
# tmuxgo
#
# Manage the persistent Foot + tmux workspace.
#
# Workspace windows:
#
#   shell  -> starts rain, then becomes zsh when rain exits
#   lf
#   nvim
#   wiki
#
# Usage:
#
#   tmuxgo focus
#   tmuxgo shell
#   tmuxgo lf
#   tmuxgo nvim
#   tmuxgo wiki
#   tmuxgo new
#

SESSION="workspace"
APP_ID="foot-tmux"
BIN_DIR="$HOME/.dotfiles/bin"

usage() {
    printf '%s\n' \
        "Usage: ${0##*/} focus | shell | lf | nvim | wiki | new" \
        >&2
    exit 1
}

has_tmux_session() {
    tmux has-session -t "$SESSION" 2>/dev/null
}

has_foot_window() {
    swaymsg -t get_tree 2>/dev/null |
        grep -q "\"app_id\": *\"$APP_ID\""
}

focus_foot_window() {
    swaymsg "[app_id=\"$APP_ID\"] focus" >/dev/null 2>&1
}

wait_for_tmux_session() {
    tries=0

    until has_tmux_session; do
        tries=$((tries + 1))

        if [ "$tries" -gt 100 ]; then
            printf '%s\n' \
                "Timed out waiting for tmux session: $SESSION" \
                >&2
            exit 1
        fi

        sleep 0.05
    done
}

start_workspace_terminal() {
    #
    # Existing tmux session:
    # Start a new Foot client attached to the existing workspace.
    #
    # No tmux session:
    # Start tmuxattach, which creates the shell, lf, nvim, and wiki windows.
    #
    if has_tmux_session; then
        foot \
            --app-id="$APP_ID" \
            -e tmux attach-session -t "$SESSION" &
    else
        foot \
            --app-id="$APP_ID" \
            -e "$BIN_DIR/tmuxattach" &

        wait_for_tmux_session
    fi
}

ensure_workspace_terminal() {
    #
    # Recovery behaviour:
    #
    # If the Foot tmux terminal was accidentally closed, but the persistent
    # tmux session is still alive, this opens a new Foot terminal and
    # reconnects it to the same session.
    #
    if ! has_foot_window; then
        start_workspace_terminal
    fi
}

select_or_create_shell() {
    if ! tmux select-window -t "$SESSION:shell" 2>/dev/null; then
        tmux new-window \
            -t "$SESSION:" \
            -n "shell" \
            -c "$HOME" \
            'rain; exec zsh -i'
    fi
}

select_or_create_lf() {
    if ! tmux select-window -t "$SESSION:lf" 2>/dev/null; then
        tmux new-window \
            -t "$SESSION:" \
            -n "lf" \
            -c "$HOME" \
            zsh -ic 'lfcd; exec zsh -i'
    fi
}

select_or_create_nvim() {
    if ! tmux select-window -t "$SESSION:nvim" 2>/dev/null; then
        tmux new-window \
            -t "$SESSION:" \
            -n "nvim" \
            -c "$HOME" \
            nvim
    fi
}

select_or_create_wiki() {
    if ! tmux select-window -t "$SESSION:wiki" 2>/dev/null; then
        tmux new-window \
            -t "$SESSION:" \
            -n "wiki" \
            -c "$HOME" \
            'nvim +VimwikiIndex'
    fi
}

new_shell_window() {
    tmux new-window \
        -t "$SESSION:" \
        -c "#{pane_current_path}" \
        zsh -i
}

[ "$#" -eq 1 ] || usage

action=$1

ensure_workspace_terminal

case "$action" in
    focus)
        # Keep the active tmux window and pane unchanged.
        ;;

    shell)
        select_or_create_shell
        ;;

    lf)
        select_or_create_lf
        ;;

    nvim)
        select_or_create_nvim
        ;;

    wiki)
        select_or_create_wiki
        ;;

    new)
        new_shell_window
        ;;

    *)
        usage
        ;;
esac

focus_foot_window
