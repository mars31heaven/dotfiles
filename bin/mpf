#!/usr/bin/env bash
#
# mpf: MPD helper with mpc + fzf.
#
# One menu. Enter runs the action and returns to the menu; Esc exits.
# Albums: pick an artist first, then one of that artist's albums.
# Playlist picker: pick an existing playlist, or type a new name and
# press Enter to create it.
#
# Albums are identified by album artist + album name. MPD falls back
# to the track artist when a file has no album artist.

set -euo pipefail

for cmd in mpc fzf shuf wl-copy; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "mpf: $cmd was not found in PATH." >&2
        exit 1
    }
done

FZF=(--height=70% --layout=reverse --border --cycle)

# ── MPD protocol (mpc 0.35 has no playlistadd) ───────────────

# Quote a value for the MPD protocol.
mpd_quote() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}

# Send one raw command to MPD and wait for OK.
# Uses MPD_HOST and MPD_PORT (default 127.0.0.1:6600). Passwords and
# Unix sockets in MPD_HOST are not handled.
mpd_cmd() {
    local host=${MPD_HOST:-127.0.0.1} port=${MPD_PORT:-6600} line

    # The redirect is scoped to this group so stderr stays visible.
    if ! { exec 3<>"/dev/tcp/$host/$port"; } 2>/dev/null; then
        echo "mpf: cannot connect to MPD at $host:$port" >&2
        return 1
    fi

    read -r -u 3 _                       # greeting: "OK MPD x.y.z"
    printf '%s\n' "$1" >&3

    while IFS= read -r -u 3 line; do
        case $line in
            OK) break ;;
            ACK*) echo "mpf: $line" >&2; exec 3>&-; return 1 ;;
        esac
    done
    exec 3>&-
}

# playlist_add PLAYLIST FILE
playlist_add() {
    mpd_cmd "playlistadd $(mpd_quote "$1") $(mpd_quote "$2")"
}

# Folder of the current track, as an absolute path. Set MPD_MUSIC_DIR
# if your music directory is not ~/Music.
MUSIC_DIR="${MPD_MUSIC_DIR:-$HOME/Music}"

# Copy the current track's folder to the clipboard, wrapped in single
# quotes so it can be pasted after `cd `. Prints nothing on success.
copy_current_folder() {
    local file dir path
    file=$(mpc -f '%file%' current) || true
    [[ -n "$file" ]] || return 1
    if [[ "$file" == */* ]]; then dir=${file%/*}; else dir=.; fi
    path="$MUSIC_DIR/$dir"
    path=${path//"'"/"'\\''"}
    printf "'%s'" "$path" | wl-copy
}

# ── Pickers ──────────────────────────────────────────────────

choose_track() {
    mpc listall | fzf "${FZF[@]}" --prompt="Track > "
}

# Artist first, then that artist's albums. Prints "artist<TAB>album".
choose_album() {
    local artist album

    artist=$(mpc list albumartist | sed '/^[[:space:]]*$/d' | sort -f |
        fzf "${FZF[@]}" --prompt="Artist > ") || return 1

    album=$(mpc list album albumartist "$artist" | sed '/^[[:space:]]*$/d' | sort -f |
        ARTIST_SEL="$artist" fzf "${FZF[@]}" --prompt="$artist > " \
            --preview='mpc -f "%track% - %title%" find albumartist "$ARTIST_SEL" album {} | head -n 25' \
            --preview-window=right:55%:wrap) || return 1

    printf '%s\t%s\n' "$artist" "$album"
}

# Random "artist<TAB>album" pair from the whole library.
random_album() {
    local pair

    pair=$(mpc -f '[%albumartist%|%artist%]\t%album%' listall |
        awk -F'\t' '$1 != "" && $2 != ""' |
        sort -u | shuf -n 1)

    [[ -n "$pair" ]] || {
        echo "mpf: no albums found." >&2
        return 1
    }
    printf '%s\n' "$pair"
}

# Existing playlist, or a new name typed into the query.
choose_playlist() {
    local out rc=0
    out=$(mpc lsplaylists |
        fzf "${FZF[@]}" --print-query \
            --prompt="Playlist (type a new name to create) > ") || rc=$?
    case $rc in
        0) tail -n1 <<< "$out" ;;
        1) head -n1 <<< "$out" ;;
        *) return 1 ;;
    esac
}

# ── Actions ──────────────────────────────────────────────────

# Takes an "artist<TAB>album" value.
album_files() {
    local artist=${1%%$'\t'*} album=${1#*$'\t'}
    mpc -f '%file%' find albumartist "$artist" album "$album"
}

# Insert after the playing track; if nothing is playing, append.
play_next() {
    if [[ -n "$(mpc current)" ]]; then
        mpc insert "$1" >/dev/null
    else
        mpc add "$1"
    fi
}

# Each insert lands right after the current track, so insert the
# album backwards to keep its order. With nothing playing, tracks
# are appended, so they go in forward order.
play_next_album() {
    local tracks i
    mapfile -t tracks < <(album_files "$1")

    if [[ -z "$(mpc current)" ]]; then
        for ((i = 0; i < ${#tracks[@]}; i++)); do
            if [[ -n "${tracks[i]}" ]]; then mpc add "${tracks[i]}"; fi
        done
        return 0
    fi

    for ((i = ${#tracks[@]} - 1; i >= 0; i--)); do
        if [[ -n "${tracks[i]}" ]]; then mpc insert "${tracks[i]}" >/dev/null; fi
    done
}

queue_album() {
    local t
    while IFS= read -r t; do
        if [[ -n "$t" ]]; then mpc add "$t"; fi
    done < <(album_files "$1")
}

# Replace the queue with an album and start playing.
play_now_album() {
    mpc clear >/dev/null
    queue_album "$1"
    mpc play >/dev/null
}

# Add N random tracks to the queue (asks for N, default 5).
queue_random_tracks() {
    local count
    read -r -p "How many tracks?  " count
    count=${count:-5}

    if [[ ! "$count" =~ ^[0-9]+$ ]]; then
        echo "Not a number: $count"
        return 1
    fi

    mpc listall | shuf -n "$count" | mpc add
}

playlist_add_album() {
    local t
    while IFS= read -r t; do
        if [[ -n "$t" ]]; then playlist_add "$1" "$t"; fi
    done < <(album_files "$2")
}

# ── Menu ─────────────────────────────────────────────────────

pretty() { printf '%s' "${1//$'\t'/ - }"; }

main() {
    local action track album playlist

    while true; do
        action=$(printf '%s\n' \
            "Play next: track" \
            "Play next: album" \
            "Play next: random album" \
            "Queue: track" \
            "Queue: album" \
            "Queue: random album" \
            "Queue: random tracks" \
            "Play now: album" \
            "Play now: random album" \
            "Current track: copy folder" \
            "Playlist: add track" \
            "Playlist: add album" \
            "Playlist: add current track" \
            "Playlist: load into queue" |
            fzf "${FZF[@]}" --prompt="mpf > ") || exit 0

        case "$action" in
            "Play next: track")
                track=$(choose_track) || continue
                play_next "$track"
                echo "Next: $track"
                ;;
            "Play next: album")
                album=$(choose_album) || continue
                play_next_album "$album"
                echo "Next: $(pretty "$album")"
                ;;
            "Play next: random album")
                album=$(random_album) || continue
                play_next_album "$album"
                echo "Next (random): $(pretty "$album")"
                ;;
            "Queue: track")
                track=$(choose_track) || continue
                mpc add "$track"
                echo "Queued: $track"
                ;;
            "Queue: album")
                album=$(choose_album) || continue
                queue_album "$album"
                echo "Queued: $(pretty "$album")"
                ;;
            "Queue: random album")
                album=$(random_album) || continue
                queue_album "$album"
                echo "Queued (random): $(pretty "$album")"
                ;;
            "Queue: random tracks")
                queue_random_tracks || continue
                echo "Queued random tracks."
                ;;
            "Play now: album")
                album=$(choose_album) || continue
                play_now_album "$album"
                echo "Playing: $(pretty "$album")"
                ;;
            "Play now: random album")
                album=$(random_album) || continue
                play_now_album "$album"
                echo "Playing (random): $(pretty "$album")"
                ;;
            "Current track: copy folder")
                if copy_current_folder; then
                    exit 0
                fi
                echo "Nothing is playing."
                ;;
            "Playlist: add track")
                track=$(choose_track) || continue
                playlist=$(choose_playlist) || continue
                [[ -n "$playlist" ]] || continue
                playlist_add "$playlist" "$track"
                echo "Added to $playlist: $track"
                ;;
            "Playlist: add album")
                album=$(choose_album) || continue
                playlist=$(choose_playlist) || continue
                [[ -n "$playlist" ]] || continue
                playlist_add_album "$playlist" "$album"
                echo "Added to $playlist: $(pretty "$album")"
                ;;
            "Playlist: add current track")
                track=$(mpc -f '%file%' current)
                if [[ -z "$track" ]]; then
                    echo "Nothing is playing."
                    continue
                fi
                playlist=$(choose_playlist) || continue
                [[ -n "$playlist" ]] || continue
                playlist_add "$playlist" "$track"
                echo "Added to $playlist: $track"
                ;;
            "Playlist: load into queue")
                playlist=$(choose_playlist) || continue
                [[ -n "$playlist" ]] || continue
                mpc load "$playlist"
                echo "Loaded: $playlist"
                ;;
        esac
    done
}

main
