#!/bin/sh

choice=$(printf '%s\n' \
    "Toggle Sunset" \
    "Suspend" \
    "Reboot" \
    "Poweroff" |
    fuzzel --dmenu --prompt="Power: ")

case "$choice" in
    "Toggle Sunset")
        if pgrep -x wlsunset > /dev/null; then
            pkill wlsunset
        else
            wlsunset -t 4000 -T 4200 > /dev/null 2>&1 &
        fi
        ;;
    Suspend)
        systemctl suspend
        ;;
    Reboot)
        systemctl reboot
        ;;
    Poweroff)
        systemctl poweroff
        ;;
esac
