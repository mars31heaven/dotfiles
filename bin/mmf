#!/bin/sh
MUSIC_DIR="$HOME/Music"
album=$(
    find "$MUSIC_DIR" -mindepth 2 -type f \
        \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.m4a' -o -iname '*.wav' \) \
        -printf '%h\n' |
    sort -u |
    fzf --prompt='Album > ' \
        --height=100% \
        --reverse
)
[ -z "$album" ] && exit 0
exec mpv --profile=music --input-ipc-server="${XDG_RUNTIME_DIR:-/tmp}/mpv-music-$$.sock" "$album"
