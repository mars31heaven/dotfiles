#!/usr/bin/env python3
"""Minimal Last.fm recent tracks viewer."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

API_URL = "https://ws.audioscrobbler.com/2.0/"
CONFIG = os.path.expanduser("~/.config/lastfm/config")
KEYCHAIN_COMMANDS = [
    ["security", "find-generic-password", "-s", "lastfm-api-key", "-w"],
    ["secret-tool", "lookup", "service", "lastfm-api-key"],
]

HELP_EPILOG = """\
setup:
  1. Get an API key at https://www.last.fm/api/account/create
  2. Store it outside your dotfiles, using one of:

     macOS keychain:
       security add-generic-password -a "$USER" -s lastfm-api-key -w

     Linux keyring:
       secret-tool store --label=lastfm service lastfm-api-key

     Config file (then run: chmod 600 ~/.config/lastfm/config):
       user=your_username
       key=your_api_key

  The key can also be passed through LASTFM_API_KEY.
  The username can come from -u, LASTFM_USER or the config file.

examples:
  lastfm          latest 10 scrobbles
  lastfm -n 20    latest 20 scrobbles
  lastfm -w       top tracks and artists, last 7 days
  lastfm -m       top tracks and artists, last 30 days
"""


def read_config():
    values = {}
    if not os.path.isfile(CONFIG):
        return values
    if os.stat(CONFIG).st_mode & 0o077:
        print(f"warning: {CONFIG} is readable by others (run chmod 600)", file=sys.stderr)
    with open(CONFIG) as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                values[k.strip()] = v.strip()
    return values


def keychain_key():
    for cmd in KEYCHAIN_COMMANDS:
        if shutil.which(cmd[0]):
            try:
                out = subprocess.run(
                    cmd, capture_output=True, text=True, timeout=5
                ).stdout.strip()
            except subprocess.SubprocessError:
                continue
            if out:
                return out
    return None


def get_credentials(cli_user):
    cfg = read_config()
    user = cli_user or os.environ.get("LASTFM_USER") or cfg.get("user")
    key = os.environ.get("LASTFM_API_KEY") or keychain_key() or cfg.get("key")
    if not user or not key:
        sys.exit("missing username or API key (see lastfm -h)")
    return user, key


def call(user, key, method, **params):
    params.update(method=method, user=user, api_key=key, format="json")
    url = f"{API_URL}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": "lastfm-cli/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            data = json.loads(e.read().decode())
        except Exception:
            sys.exit(f"http error {e.code}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"network error: {e}")
    if "error" in data:
        sys.exit(f"error {data['error']}: {data.get('message', '')}")
    return data


def as_list(value):
    if value is None:
        return []
    return value if isinstance(value, list) else [value]


def ago(uts):
    seconds = max(0, int(time.time()) - uts)
    for unit, size in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if seconds >= size:
            n = seconds // size
            if unit == "day" and n >= 30:
                return time.strftime("%Y-%m-%d", time.localtime(uts))
            return f"{n} {unit}{'s' if n != 1 else ''} ago"
    return "just now"


def cw(text):
    """Display width of a string (handles accents and wide characters)."""
    width = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width


def fit(text, width, right=False):
    if cw(text) > width:
        out, used = "", 0
        for ch in text:
            w = cw(ch)
            if used + w > width - 3:
                break
            out += ch
            used += w
        text = out + "..."
    pad = " " * (width - cw(text))
    return pad + text if right else text + pad


def table(rows):
    """Boxed table, columns sized to content. Last column is right-aligned."""
    if not rows:
        return
    ncols = len(rows[0])
    widths = [max(cw(r[i]) for r in rows) for i in range(ncols)]
    total = shutil.get_terminal_size((80, 24)).columns
    # Each column adds 2 padding spaces and 1 border, plus 1 closing border.
    excess = sum(widths) + 3 * ncols + 1 - total

    while excess > 0:
        i = max(range(ncols - 1), key=lambda k: widths[k])
        if widths[i] <= 8:
            break
        widths[i] -= 1
        excess -= 1

    def rule(left, mid, right):
        return left + mid.join("─" * (w + 2) for w in widths) + right

    print(rule("┌", "┬", "┐"))
    for r in rows:
        cells = [fit(r[i], widths[i]) for i in range(ncols - 1)]
        cells.append(fit(r[-1], widths[-1], right=True))
        print("│ " + " │ ".join(cells) + " │")
    print(rule("└", "┴", "┘"))


def recent(user, key, limit):
    data = call(user, key, "user.getrecenttracks", limit=limit + 1)
    tracks = [t for t in as_list(data["recenttracks"].get("track")) if "date" in t]
    rows = [
        (
            t.get("name", ""),
            t.get("artist", {}).get("#text", ""),
            ago(int(t["date"]["uts"])),
        )
        for t in tracks[:limit]
    ]
    table(rows)


def top(user, key, period, limit):
    tracks = call(user, key, "user.gettoptracks", period=period, limit=limit)
    table([
        (t.get("name", ""), t.get("artist", {}).get("name", ""), t.get("playcount", ""))
        for t in as_list(tracks["toptracks"].get("track"))
    ])
    albums = call(user, key, "user.gettopalbums", period=period, limit=limit)
    table([
        (a.get("name", ""), a.get("artist", {}).get("name", ""), a.get("playcount", ""))
        for a in as_list(albums["topalbums"].get("album"))
    ])
    artists = call(user, key, "user.gettopartists", period=period, limit=limit)
    table([
        (a.get("name", ""), a.get("playcount", ""))
        for a in as_list(artists["topartists"].get("artist"))
    ])


def main():
    p = argparse.ArgumentParser(
        prog="lastfm",
        usage="lastfm [-n N] [-w | -m] [-u USER]",
        description="Show your latest Last.fm scrobbles in the terminal.",
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-n", "--limit", type=int, default=10, metavar="N",
                   help="rows to show (default 10)")
    p.add_argument("-u", "--user", metavar="USER", help="Last.fm username")
    group = p.add_mutually_exclusive_group()
    group.add_argument("-w", "--week", action="store_true",
                       help="top tracks and artists, last 7 days")
    group.add_argument("-m", "--month", action="store_true",
                       help="top tracks and artists, last 30 days")
    args = p.parse_args()

    user, key = get_credentials(args.user)

    if args.week:
        top(user, key, "7day", args.limit)
    elif args.month:
        top(user, key, "1month", args.limit)
    else:
        recent(user, key, args.limit)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
    except KeyboardInterrupt:
        sys.exit(130)
