#!/usr/bin/env bash

set -euo pipefail

# Wayland password menu using pass + fuzzel.
#
# Dependencies:
#   pass
#   fuzzel
#   wl-clipboard
#   wtype
#
# Usage:
#   passmenu

PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.local/share/password-store}"

# Make sure the password store exists.
if [[ ! -d "$PASSWORD_STORE_DIR" ]]; then
    printf 'Password store not found: %s\n' "$PASSWORD_STORE_DIR" >&2
    exit 1
fi

# Find password entries.
mapfile -t entries < <(
    find "$PASSWORD_STORE_DIR" \
        -type f \
        -name '*.gpg' \
        -printf '%P\n' |
    sed 's/\.gpg$//' |
    sort
)

if ((${#entries[@]} == 0)); then
    exit 0
fi

# Select an entry.
entry=$(
    printf '%s\n' "${entries[@]}" |
    fuzzel --dmenu --prompt='Password: '
)

[[ -n "$entry" ]] || exit 0

# Select an action.
action=$(
    printf '%s\n' \
        'Copy username' \
        'Copy password' \
        'Type username' \
        'Type password' |
    fuzzel --dmenu --prompt='Action: '
)

[[ -n "$action" ]] || exit 0

case "$action" in
    'Copy username')
        username=$(
            pass show "$entry" |
            sed -n 's/^username:[[:space:]]*//p' |
            head -n1
        )

        [[ -n "$username" ]] || exit 1

        printf '%s' "$username" | wl-copy
        ;;

    'Copy password')
        pass show -c "$entry" >/dev/null
        ;;

    'Type username')
        username=$(
            pass show "$entry" |
            sed -n 's/^username:[[:space:]]*//p' |
            head -n1
        )

        [[ -n "$username" ]] || exit 1

        printf '%s' "$username" | wtype -
        ;;

    'Type password')
        pass show "$entry" |
            head -n1 |
            wtype -
        ;;

    *)
        exit 1
        ;;
esac
