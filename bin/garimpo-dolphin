#!/bin/bash

RAIZ_ATUAL=$(pwd)

echo "-------------------------------------------------------"
echo "📂 Garimpando no diretório atual: $RAIZ_ATUAL"
echo "🎲 Escolhendo 3 álbuns e abrindo no Dolphin..."
echo "-------------------------------------------------------"

# Configura o Bash para tratar apenas quebras de linha como separadores (lida com espaços nos nomes)
IFS=$'\n'

# 1. Sorteia as 3 pastas (caminhos absolutos) usando caminhos seguros
albuns=($(find "$RAIZ_ATUAL" -type f \( -iname "*.mp3" -o -iname "*.flac" -o -iname "*.m4a" \) -printf '%h\n' | sort -u | shuf -n 3))

if [ ${#albuns[@]} -eq 0 ]; then
    echo "❌ Nenhuma pasta com áudio encontrada aqui."
    exit 1
fi

# Converte para caminhos reais (resolvendo o problema do realpath com espaços)
for i in "${!albuns[@]}"; do
    albuns[$i]=$(realpath "${albuns[$i]}")
done

# 2. Abre as 3 pastas no Dolphin (cada uma em uma aba)
dolphin "${albuns[@]}" > /dev/null 2>&1 &

# 3. Exibe os caminhos e as capas no terminal com CHAFA
for i in "${!albuns[@]}"; do
    index=$((i+1))
    echo "[$index] ${albuns[$i]}"
    
    # Busca a capa de forma segura
    capa=$(find "${albuns[$i]}" -maxdepth 1 -type f \( -iname "cover.jpg" -o -iname "cover.png" \) | head -n 1)
    
    if [ -n "$capa" ]; then
        chafa --size=40x20 "$capa"
        echo ""
    else
        echo "[Sem capa encontrada]"
    fi
    echo "-------------------------------------------------------"
done

# 4. Pergunta sobre o Modo Degustação
echo -n "Deseja ouvir uma prévia de 30s de cada? (s/n): "
read -r resposta

if [[ "$resposta" =~ ^[sS]$ ]]; then
    for pasta in "${albuns[@]}"; do
        echo "🎵 Agora em: $(basename "$pasta")"
        # Garante que o mpv trate o glob (*) corretamente com aspas
        mpv --shuffle --no-video --length=30 "$pasta"/* 2>/dev/null
    done
fi

# Restaura o separador padrão do sistema
unset IFS

echo "Bom garimpo!"
