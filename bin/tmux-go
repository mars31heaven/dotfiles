#!/bin/sh
# Manage the persistent foot + tmux workspace.
#
# Usage:
#   tmux-go focus
#       Focus the persistent terminal without changing tmux state.
#
#   tmux-go new
#       Create a new zsh tmux window in the active pane's directory.
#
#   tmux-go nvim
#       Select the Neovim window, creating it if missing.
#
#   tmux-go wiki
#       Select the Vimwiki window, creating it if missing.
#
#   tmux-go lf
#       Select lf, creating it through the lfcd zsh function if missing.
#
#   tmux-go news
#       Select Newsboat, creating it if missing.
#
#   tmux-go NAME [COMMAND...]
#       Select tmux window NAME. Create it with COMMAND if it is missing.

SESSION=workspace
APP_ID=foot-tmux
BIN_DIR="$HOME/.dotfiles/bin"

usage() {
    printf '%s\n' "usage: ${0##*/} focus | new | NAME [COMMAND...]" >&2
    exit 1
}

has_foot_window() {
    swaymsg -t get_tree 2>/dev/null |
        grep -q "\"app_id\": *\"$APP_ID\""
}

focus_foot_window() {
    swaymsg "[app_id=\"$APP_ID\"] focus" >/dev/null 2>&1
}

wait_for_tmux_session() {
    tries=0

    until tmux has-session -t "=$SESSION" 2>/dev/null; do
        tries=$((tries + 1))

        if [ "$tries" -gt 100 ]; then
            printf '%s\n' "Timed out waiting for tmux session: $SESSION" >&2
            exit 1
        fi

        sleep 0.05
    done
}

[ "$#" -ge 1 ] || usage

action=$1
shift

# Start the persistent terminal if it is not running.
#
# tmux-attach creates the workspace session on first launch.
if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    if ! has_foot_window; then
        foot --app-id="$APP_ID" -e "$BIN_DIR/tmux-attach" &
    fi

    wait_for_tmux_session
fi

case "$action" in
    focus)
        # Keep the active tmux window and pane exactly as they are.
        ;;

    new)
        # Create a normal shell window in the directory of the active pane.
        tmux new-window \
            -t "=$SESSION:" \
            -c "#{pane_current_path}" \
            zsh
        ;;

    nvim)
        if ! tmux select-window -t "=$SESSION:=nvim" 2>/dev/null; then
            tmux new-window \
                -t "=$SESSION:" \
                -n nvim \
                -c "$HOME" \
                nvim
        fi
        ;;

    wiki)
        if ! tmux select-window -t "=$SESSION:=wiki" 2>/dev/null; then
            tmux new-window \
                -t "=$SESSION:" \
                -n wiki \
                -c "$HOME" \
                'nvim +VimwikiIndex'
        fi
        ;;

    lf)
        if ! tmux select-window -t "=$SESSION:=lf" 2>/dev/null; then
            # zsh -i loads ~/.zshrc, where lfcd is defined.
            #
            # When lf exits, lfcd changes the shell directory to lf's last
            # directory. exec zsh -i keeps that shell open in the new path.
            tmux new-window \
                -t "=$SESSION:" \
                -n lf \
                -c "$HOME" \
                zsh -ic 'lfcd; exec zsh -i'
        fi
        ;;

    news)
        if ! tmux select-window -t "=$SESSION:=news" 2>/dev/null; then
            tmux new-window \
                -t "=$SESSION:" \
                -n news \
                -c "$HOME" \
                newsboat
        fi
        ;;

    *)
        if tmux select-window -t "=$SESSION:=$action" 2>/dev/null; then
            :
        elif [ "$#" -gt 0 ]; then
            tmux new-window \
                -t "=$SESSION:" \
                -n "$action" \
                -c "#{pane_current_path}" \
                "$@"
        else
            tmux new-window \
                -t "=$SESSION:" \
                -n "$action" \
                -c "#{pane_current_path}" \
                zsh
        fi
        ;;
esac

focus_foot_window
