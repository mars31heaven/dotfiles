#!/bin/sh

# Open files in applications baseds on file extension

[ -n "$1" ] || exit 1

case "$1" in
    *.mp3|*.flac|*.wav|*.ogg|*.opus|*.aiff|*.m4a|*.aac|*.m3u|*.pls)
        setsid -f foot mpv --profile=music "$1"
        ;;

    *.mp4|*.mkv|*.webm|*.avi|*.mpg)
        umpv "$1" >/dev/null 2>&1
        ;;

    *.png|*.gif|*.jpg|*.jpeg|*.jpe)
        exec swayimg "$1"
        ;;

    *.pdf|*.cbr|*.epub)
        exec zathura "$1"
        ;;

    http*|www*|*.html)
        setsid -f "$BROWSER" "$1" >/dev/null 2>&1
        ;;

    *.torrent)
        setsid -f qbittorrent "$1" >/dev/null 2>&1
        ;;

    *)
        exec "$EDITOR" "$1"
        ;;
esac
