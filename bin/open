#!/bin/sh

[ -n "$1" ] || exit 1

case "$1" in
    *.mp3|*.flac|*.wav|*.ogg|*.opus|*.aiff|*.m4a|*.aac|*.m3u|*.pls)
        setsid -f foot mpv --profile=music --input-ipc-server="${XDG_RUNTIME_DIR:-/tmp}/mpv-music.sock" "$1"
        ;;

    *.mp4|*.mkv|*.webm|*.avi|*.mpg|*.mov)
        umpv "$1" >/dev/null 2>&1
        ;;

    *.png|*.gif|*.jpg|*.jpeg|*.jpe|*.webp|*.tiff)
        setsid -f swayimg "$1" >/dev/null 2>&1
        ;;

    *.pdf|*.cbr|*.cbz|*.epub)
        setsid -f zathura "$1" >/dev/null 2>&1
        ;;

    http*|www*|*.html|*.htm)
        setsid -f "$BROWSER" "$1" >/dev/null 2>&1
        ;;

    *.docx|*.doc|*.odt)
        setsid -f lowriter "$1" >/dev/null 2>&1
        ;;

    *.xlsx|*.xls|*.ods|*.csv)
        setsid -f localc "$1" >/dev/null 2>&1
        ;;

    *.torrent)
        setsid -f qbittorrent "$1" >/dev/null 2>&1
        ;;

    *)
        exec "$EDITOR" "$1"
        ;;
esac

