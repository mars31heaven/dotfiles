#!/bin/sh

choice=$(printf '%s\n' \
    "Turn Off Screen" \
    "Suspend" \
    "Reboot" \
    "Poweroff" |
    fuzzel --dmenu --prompt="Power: ")

case "$choice" in
    "Turn Off Screen")
        pkill -USR1 swayidle
        ;;
    Suspend)
        systemctl suspend
        ;;
    Reboot)
        systemctl reboot
        ;;
    Poweroff)
        systemctl poweroff
        ;;
esac

