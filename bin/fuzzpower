#!/bin/sh

choice=$(printf '%s\n' \
    "Turn Off Screen" \
    "Suspend" \
    "Reboot" \
    "Poweroff" |
    fuzzel --dmenu --prompt="Power: ")

# This line was missing:
case "$choice" in
    "Turn Off Screen")
        sleep 1
        wlopm --off \*
        ;;
    Suspend)
        systemctl suspend
        ;;
    Reboot)
        systemctl reboot
        ;;
    Poweroff)
        systemctl poweroff
        ;;
esac
