#!/bin/sh

if pgrep -x swayidle >/dev/null; then
    pkill -x swayidle
    notify-send "Idle management disabled"
else
    swayidle -w \
        timeout 300 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
        timeout 600 'systemctl suspend' &
    notify-send "Idle management enabled"
fi
