#!/usr/bin/env bash
set -euo pipefail

if ! command -v pandoc >/dev/null 2>&1; then
  echo "Erro: Pandoc não está instalado."
  exit 1
fi

INPUT="${1:-Atendimento_Assistencia_Tecnica_Chat_Voice.md}"
OUTPUT="${2:-${INPUT%.md}.docx}"

pandoc "$INPUT" \
  --from=gfm \
  --to=docx \
  --standalone \
  --toc \
  --toc-depth=3 \
  -o "$OUTPUT"

echo "Gerado: $OUTPUT"
