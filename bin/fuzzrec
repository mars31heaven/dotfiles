#!/usr/bin/env bash

# Wayland/Sway screen and audio recorder
# Modes: screen-mic-system, screen-mic, screen-system, mic, system, kill
# Requirements: wf-recorder, ffmpeg, fuzzel, pactl

set -euo pipefail

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/recording.pid"
MODEFILE="${XDG_RUNTIME_DIR:-/tmp}/recording.mode"
OUTPUT_DIR="$HOME/Videos/Recordings"

mkdir -p "$OUTPUT_DIR"

die() { printf 'Error: %s\n' "$1" >&2; exit 1; }
timestamp() { date '+%y%m%d-%H%M-%S'; }
is_recording() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
cleanup_pidfile() { rm -f "$PIDFILE" "$MODEFILE"; }
get_mic() { 查看=$(pactl get-default-source); echo "$查看"; }
get_sink() { echo "$(pactl get-default-sink)"; }
get_system_audio() { printf '%s.monitor\n' "$(get_sink)"; }

COMBINED_SINK="record_mix"
LOOP_MIC=""
LOOP_SYSTEM=""

create_combined_source() {
    local mic system
    mic="$(get_mic)"
    system="$(get_system_audio)"

    # PipeWire-compatible null sink creation
    pactl load-module module-null-sink \
        sink_name="$COMBINED_SINK" \
        sink_properties=device.description=RecordingMix \
        >/dev/null

    LOOP_MIC=$(pactl load-module module-loopback source="$mic" sink="$COMBINED_SINK" latency_msec=20)
    LOOP_SYSTEM=$(pactl load-module module-loopback source="$system" sink="$COMBINED_SINK" latency_msec=20)
}

destroy_combined_source() {
    [[ -n "$LOOP_MIC" ]] && pactl unload-module "$LOOP_MIC" 2>/dev/null || true
    [[ -n "$LOOP_SYSTEM" ]] && pactl unload-module "$LOOP_SYSTEM" 2>/dev/null || true
    pactl unload-module module-null-sink 2>/dev/null || true
    LOOP_MIC=""
    LOOP_SYSTEM=""
}

kill_recording() {
    if ! is_recording; then
        cleanup_pidfile
        destroy_combined_source
        exit 0
    fi

    local pid
    pid=$(cat "$PIDFILE")
    kill -INT "$pid" 2>/dev/null || true

    for _ in {1..50}; do
        if ! kill -0 "$pid" 2>/dev/null; then break; fi
        sleep 0.1
    done

    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
    fi

    destroy_combined_source
    cleanup_pidfile
}

# --- FIX 1: Fixed the wf-recorder arguments syntax ---
# --- FIX 2: Swapped to 15 FPS / CRF 28 for your "low size" requirement ---
record_screen() {
    local audio_source="$1"
    local output="$2"

    wf-recorder \
        --audio="$audio_source" \
        --framerate=15 \
        --codec=libx264 \
        --params crf=28,preset=ultrafast \
        --audio-codec=aac \
        --file="$output" &

    echo $! > "$PIDFILE"
}

record_screen_silent() {
    local output="$1"

    wf-recorder \
        --framerate=15 \
        --codec=libx264 \
        --params crf=28,preset=ultrafast \
        --file="$output" &

    echo $! > "$PIDFILE"
}

record_audio() {
    local source="$1"
    local output="$2"

    ffmpeg \
        -hide_banner \
        -loglevel warning \
        -f pulse \
        -i "$source" \
        -c:a flac \
        "$output" &

    echo $! > "$PIDFILE"
}

screen_mic_system() {
    local output="$OUTPUT_DIR/screen-$(timestamp).mp4"
    create_combined_source
    trap destroy_combined_source EXIT
    record_screen "$COMBINED_SINK.monitor" "$output"
    echo "Recording screen + mic + system audio -> $output"
}

screen_mic() {
    local output="$OUTPUT_DIR/screen-$(timestamp).mp4"
    record_screen "$(get_mic)" "$output"
    echo "Recording screen + mic -> $output"
}

screen_system() {
    local output="$OUTPUT_DIR/screen-$(timestamp).mp4"
    record_screen "$(get_system_audio)" "$output"
    echo "Recording screen + system audio -> $output"
}

mic() {
    local output="$OUTPUT_DIR/microphone-$(timestamp).flac"
    record_audio "$(get_mic)" "$output"
    echo "Recording microphone -> $output"
}

system_audio() {
    local output="$OUTPUT_DIR/system-$(timestamp).flac"
    record_audio "$(get_system_audio)" "$output"
    echo "Recording system audio -> $output"
}

menu() {
    printf '%s\n' \
        'Screen + microphone + system audio' \
        'Screen + microphone' \
        'Screen + system audio' \
        'Microphone only' \
        'System audio only' |
        fuzzel --dmenu --prompt 'Record: '
}

choose_recording() {
    local choice
    choice="$(menu)" || exit 0

    case "$choice" in
        'Screen + microphone + system audio') screen_mic_system ;;
        'Screen + microphone')                screen_mic ;;
        'Screen + system audio')            screen_system ;;
        'Microphone only')                    mic ;;
        'System audio only')                  system_audio ;;
        *)                                    exit 0 ;;
    esac
}

case "${1:-}" in
    screen-mic-system) screen_mic_system ;;
    screen-mic)        screen_mic ;;
    screen-system)     screen_system ;;
    mic)               mic ;;
    system)            system_audio ;;
    kill)              kill_recording ;;
    '')
        if is_recording; then
            printf 'A recording is already running. Stopping it now...\n'
            kill_recording
            exit 0
        fi
        choose_recording
        ;;
    *)
        printf 'Usage: %s [screen-mic-system|screen-mic|screen-system|mic|system|kill]\n' "${0##*/}"
        exit 1
        ;;
esac
